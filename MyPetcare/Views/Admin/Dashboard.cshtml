@model IEnumerable<MyPetcare.Models.User>
@{
    Layout = null;
    ViewData["Title"] = "MyPetcare - Admin Dashboard";

    // Retrieve the shared appointment list from ViewBag[cite: 5]
    var appointments = ViewBag.Appointments as List<MyPetcare.Models.AppointmentModel> ?? new List<MyPetcare.Models.AppointmentModel>();

    // Retrieve the registered users list from the Model[cite: 5]
    var users = Model ?? Enumerable.Empty<MyPetcare.Models.User>();

    // Calculate live summary statistics[cite: 5]
    int pendingCount = appointments.Count(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));
    int confirmedCount = appointments.Count(a => a.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase));
    int cancelledCount = appointments.Count(a => a.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || a.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase));
    int totalAppointments = appointments.Count;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            /* Professional Light Theme */
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --bg-sidebar: #0f172a;
            --text-main: #334155;
            --text-muted: #64748b;
            --text-heading: #0f172a;
            --text-sidebar: #94a3b8;
            --border-color: #e2e8f0;
            --header-bg: #ffffff;
            --primary-accent: #0284c7;
            --card-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
            --table-hover: #f8fafc;
            --badge-pending-bg: #fef3c7;
            --badge-pending-text: #b45309;
            --badge-approved-bg: #d1fae5;
            --badge-approved-text: #047857;
            --badge-rejected-bg: #fee2e2;
            --badge-rejected-text: #b91c1c;
            --badge-rescheduled-bg: #e0f2fe;
            --badge-rescheduled-text: #0369a1;
        }

        [data-theme="dark"] {
            /* Modern Dark Enterprise Theme */
            --bg-main: #0b0f19;
            --bg-card: #111827;
            --bg-sidebar: #0b0f19;
            --text-main: #9ca3af;
            --text-muted: #6b7280;
            --text-heading: #f9fafb;
            --text-sidebar: #94a3b8;
            --border-color: #1f2937;
            --header-bg: #111827;
            --primary-accent: #38bdf8;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            --table-hover: #1f2937;
            --badge-pending-bg: #451a03;
            --badge-pending-text: #fbbf24;
            --badge-approved-bg: #064e3b;
            --badge-approved-text: #34d399;
            --badge-rejected-bg: #7f1d1d;
            --badge-rejected-text: #f87171;
            --badge-rescheduled-bg: #075985;
            --badge-rescheduled-text: #7dd3fc;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 270px;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 28px 18px;
            box-shadow: 4px 0 15px rgba(0, 0, 0, 0.03);
            z-index: 10;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #ffffff;
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 36px;
            padding: 0 10px;
            letter-spacing: -0.3px;
        }

            .brand .brand-icon-box {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: linear-gradient(135deg, var(--primary-accent), #0369a1);
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
            }

        .sidebar-menu-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: 0.8px;
            padding: 0 10px 10px 10px;
        }

        .nav-menu {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            color: var(--text-sidebar);
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            position: relative;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .nav-link i {
                font-size: 1rem;
                width: 20px;
                text-align: center;
                transition: transform 0.2s ease;
            }

            .nav-link:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #ffffff;
                transform: translateX(3px);
            }

                .nav-link:hover i {
                    transform: scale(1.1);
                }

            .nav-link.active {
                font-weight: 600;
                background: linear-gradient(90deg, rgba(2, 132, 199, 0.2), rgba(2, 132, 199, 0.05));
                color: var(--primary-accent);
                border-left: 3.5px solid var(--primary-accent);
                border-radius: 4px 8px 8px 4px;
            }

                .nav-link.active i {
                    color: var(--primary-accent);
                }

        .sidebar-footer {
            display: flex;
            flex-direction: column;
            gap: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 18px;
        }

        .sidebar-admin-badge {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

            .sidebar-admin-badge .avatar-fallback {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--primary-accent);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 0.85rem;
            }

        .edit-profile-icon-btn {
            background: transparent;
            border: none;
            color: var(--text-sidebar);
            cursor: pointer;
            font-size: 0.9rem;
            transition: color 0.2s ease;
        }

            .edit-profile-icon-btn:hover {
                color: var(--primary-accent);
            }

        .logout-btn {
            background-color: rgba(239, 68, 68, 0.1);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.2);
            padding: 11px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

            .logout-btn:hover {
                background-color: rgba(239, 68, 68, 0.2);
                color: #ef4444;
                transform: translateY(-1px);
            }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .header {
            background-color: var(--header-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 18px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.3px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .theme-toggle-btn {
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .theme-toggle-btn:hover {
                border-color: var(--primary-accent);
            }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-heading);
        }

        .dashboard-body {
            padding: 28px 36px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .admin-section {
            display: none;
        }

            .admin-section.active {
                display: flex;
                flex-direction: column;
                gap: 24px;
                animation: fadeInSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

        @@keyframes fadeInSlideUp {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .stat-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--card-shadow);
            cursor: pointer;
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px -5px rgba(2, 132, 199, 0.12);
                border-color: var(--primary-accent);
            }

            .stat-card.active-filter {
                border-color: var(--primary-accent);
                background: linear-gradient(135deg, rgba(2, 132, 199, 0.05), transparent);
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background-color: rgba(2, 132, 199, 0.08);
            color: var(--primary-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: transform 0.3s ease;
        }

        .stat-card:hover .stat-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-heading);
            line-height: 1.2;
        }

        .stat-label {
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .table-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 22px;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .table-card-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-heading);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        th, td {
            text-align: left;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
        }

        th {
            color: var(--text-muted);
            font-weight: 600;
            background-color: var(--bg-main);
            cursor: pointer;
            user-select: none;
            transition: color 0.2s ease;
        }

            th:hover {
                color: var(--primary-accent);
            }

            th i {
                margin-left: 6px;
                font-size: 0.75rem;
                color: var(--text-muted);
            }

        tbody tr:hover {
            background-color: var(--table-hover);
        }

        .badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .badge-pending {
            background-color: var(--badge-pending-bg);
            color: var(--badge-pending-text);
            animation: pulse-glow 2s infinite ease-in-out;
        }

        @@keyframes pulse-glow {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.6;
            }
        }

        .badge-approved, .badge-confirmed {
            background-color: var(--badge-approved-bg);
            color: var(--badge-approved-text);
        }

        .badge-rejected, .badge-cancelled {
            background-color: var(--badge-rejected-bg);
            color: var(--badge-rejected-text);
        }

        .badge-rescheduled {
            background-color: var(--badge-rescheduled-bg);
            color: var(--badge-rescheduled-text);
        }

        .btn-action {
            padding: 6px 12px;
            border-radius: 5px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            font-size: 0.8rem;
            margin-right: 4px;
            transition: transform 0.15s ease, opacity 0.2s ease;
        }

            .btn-action:hover {
                transform: translateY(-1px);
            }

            .btn-action:active {
                transform: translateY(0) scale(0.97);
            }

        .btn-approve {
            background-color: #047857;
            color: white;
        }

        .btn-reject {
            background-color: #b91c1c;
            color: white;
        }

        .btn-delete {
            background-color: #64748b;
            color: white;
        }

        .btn-primary-custom {
            background-color: var(--primary-accent);
            color: white;
        }

        .see-more-toggle {
            display: inline-block;
            margin-top: 14px;
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-accent);
            cursor: pointer;
            background: none;
            border: none;
            text-decoration: underline;
        }

            .see-more-toggle:hover {
                opacity: 0.8;
            }

        #chatToggleBtn {
            animation: floatBounce 3s infinite ease-in-out;
        }

        @@keyframes floatBounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        #chatToggleBtn:hover {
            transform: scale(1.08) !important;
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.3) !important;
        }
    </style>
</head>
<body>

    <!-- Redesigned Modern Sidebar Navigation -->
    <aside class="sidebar">
        <div>
            <div class="brand">
                <div class="brand-icon-box">
                    <i class="fa-solid fa-house-medical"></i>
                </div>
                <span>MyPetcare</span>
            </div>

            <div class="sidebar-menu-label">Main Navigation</div>
            <ul class="nav-menu">
                <li><a class="nav-link active" onclick="switchTab('dashboard', this)"><i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span></a></li>
                <li><a class="nav-link" onclick="switchTab('appointments', this)"><i class="fa-regular fa-calendar-check"></i> <span>Appointments</span></a></li>
                <li><a class="nav-link" onclick="switchTab('deletedLogs', this)"><i class="fa-solid fa-clock-rotate-left"></i> <span>Deleted Logs (Archive)</span></a></li>
                <li><a class="nav-link" onclick="switchTab('announcements', this)"><i class="fa-solid fa-bullhorn"></i> <span>Announcements</span></a></li>
                <li><a class="nav-link" onclick="switchTab('clients', this)"><i class="fa-solid fa-users"></i> <span>Clients Directory</span></a></li>
                <li><a class="nav-link" onclick="switchTab('pets', this)"><i class="fa-solid fa-dog"></i> <span>Pet Records</span></a></li>
            </ul>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-admin-badge">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div class="avatar-fallback" id="sidebarAvatar">SA</div>
                    <div style="overflow: hidden;">
                        <span id="sidebarAdminName" style="display: block; font-size: 0.8rem; font-weight: 600; color: #f8fafc; white-space: nowrap; text-overflow: ellipsis;">System Admin</span>
                        <span id="sidebarAdminPosition" style="display: block; font-size: 0.7rem; color: #94a3b8;">Administrator Role</span>
                    </div>
                </div>
                <button class="edit-profile-icon-btn" onclick="openAdminProfileModal()" title="Edit Admin Profile">
                    <i class="fa-solid fa-pen-to-square"></i>
                </button>
            </div>
            <button class="logout-btn" onclick="window.location.href='/Account/Logout'">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <header class="header">
            <h1 id="pageTitle" class="header-title">Dashboard Overview</h1>
            <div class="header-actions">
                <button id="themeToggle" class="theme-toggle-btn">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                    <span id="themeText">Dark Mode</span>
                </button>
                <div class="user-profile">
                    <i class="fa-solid fa-user-shield" style="color: var(--primary-accent);"></i>
                    <span id="headerAdminName">System Administrator</span>
                </div>
            </div>
        </header>

        <main class="dashboard-body">

            <!-- TAB 1: DASHBOARD OVERVIEW -->
            <section id="dashboard" class="admin-section active">
                <div class="stats-grid">
                    <div class="stat-card" id="cardPending" onclick="filterAppointmentsByStatus('Pending')">
                        <div>
                            <div class="stat-label">Pending Review</div>
                            <div class="stat-number" id="statPendingCount">@pendingCount</div>
                        </div>
                        <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
                    </div>
                    <div class="stat-card" id="cardConfirmed" onclick="filterAppointmentsByStatus('Confirmed')">
                        <div>
                            <div class="stat-label">Confirmed</div>
                            <div class="stat-number" id="statConfirmedCount">@confirmedCount</div>
                        </div>
                        <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
                    </div>
                    <div class="stat-card" id="cardCancelled" onclick="filterAppointmentsByStatus('Cancelled')">
                        <div>
                            <div class="stat-label">Cancelled / Rejected</div>
                            <div class="stat-number" id="statCancelledCount">@cancelledCount</div>
                        </div>
                        <div class="stat-icon" style="color: #b91c1c; background-color: rgba(185, 28, 28, 0.08);"><i class="fa-solid fa-circle-xmark"></i></div>
                    </div>
                    <div class="stat-card" id="cardAll" onclick="filterAppointmentsByStatus('All')">
                        <div>
                            <div class="stat-label">Total Bookings</div>
                            <div class="stat-number" id="statTotalCount">@totalAppointments</div>
                        </div>
                        <div class="stat-icon"><i class="fa-solid fa-list-check"></i></div>
                    </div>
                </div>

                <div class="table-card">
                    <h2 class="table-card-title">
                        <span id="tableCardHeaderLabel">Recent Appointments & Activity Updates</span>
                        <button id="clearFilterBtn" onclick="filterAppointmentsByStatus('All')" style="display:none; font-size: 0.75rem; background: var(--bg-main); border: 1px solid var(--border-color); color: var(--primary-accent); padding: 4px 10px; border-radius: 4px; cursor: pointer;">Show All</button>
                    </h2>
                    <table>
                        <thead>
                            <tr>
                                <th onclick="sortDashboardTable('clientName')">Client Name <i id="sortIcon_dash_clientName" class="fa-solid fa-sort"></i></th>
                                <th onclick="sortDashboardTable('petName')">Pet Name <i id="sortIcon_dash_petName" class="fa-solid fa-sort"></i></th>
                                <th>Service Type</th>
                                <th onclick="sortDashboardTable('date')">Schedule Date <i id="sortIcon_dash_date" class="fa-solid fa-sort-down"></i></th>
                                <th>Current Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="dynamicDashboardAppointmentsBody">
                            <!-- Dynamic rendered rows loaded via JavaScript syncing localStorage -->
                        </tbody>
                    </table>
                    <div id="dashboardSeeMoreContainer" style="text-align: center;"></div>
                </div>
            </section>

            <!-- TAB 2: APPOINTMENTS -->
            <section id="appointments" class="admin-section">
                <div class="table-card">
                    <h2 class="table-card-title">All Clinic Appointments History</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th onclick="sortAppointmentsTable('clientName')">Client <i id="sortIcon_appt_clientName" class="fa-solid fa-sort"></i></th>
                                <th onclick="sortAppointmentsTable('petName')">Pet <i id="sortIcon_appt_petName" class="fa-solid fa-sort"></i></th>
                                <th>Service</th>
                                <th onclick="sortAppointmentsTable('date')">Schedule Date <i id="sortIcon_appt_date" class="fa-solid fa-sort-down"></i></th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="dynamicAllAppointmentsBody">
                            <!-- Dynamic rendered rows loaded via JavaScript syncing localStorage -->
                        </tbody>
                    </table>
                    <div id="appointmentsSeeMoreContainer" style="text-align: center;"></div>
                </div>
            </section>

            <!-- TAB 3: DELETED LOGS / ARCHIVE -->
            <section id="deletedLogs" class="admin-section">
                <div class="table-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h2 class="table-card-title" style="margin-bottom: 0;"><i class="fa-solid fa-clock-rotate-left"></i> Deleted Appointment Logs (Archive)</h2>
                        <button onclick="clearDeletedLogsArchive()" class="btn-action btn-reject" style="font-size: 0.75rem;"><i class="fa-solid fa-trash-can"></i> Clear Archive</button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Client Name</th>
                                <th>Pet Name</th>
                                <th>Service</th>
                                <th>Original Date</th>
                                <th>Final Status Before Deletion</th>
                                <th>Deleted Timestamp</th>
                            </tr>
                        </thead>
                        <tbody id="dynamicDeletedLogsBody">
                            <!-- Dynamic archived deleted logs loaded via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 4: ANNOUNCEMENTS MANAGEMENT -->
            <section id="announcements" class="admin-section">
                <div class="table-card" style="margin-bottom: 20px;">
                    <h2 class="table-card-title"><i class="fa-solid fa-bullhorn"></i> Broadcast New Announcement</h2>
                    <form onsubmit="postAnnouncement(event)">
                        <div style="margin-bottom: 12px;">
