    <!-- JAVASCRIPT LOGIC -->
    <script>
        let dashboardShowAll = false;
        let appointmentsShowAll = false;
        let currentStatusFilter = 'All';

        let dashboardSortCol = 'date';
        let dashboardSortDir = 'asc';

        let appointmentsSortCol = 'date';
        let appointmentsSortDir = 'asc';

        let petsSortCol = 'petName';
        let petsSortDir = 'asc';

        document.addEventListener("DOMContentLoaded", () => {
            loadAdminProfileInfo();
            loadAdminAppointmentsTables();
            loadPetRecordsTable();
            loadDeletedLogsTable();
        });

        // Built-in Web Audio API sound generator (No external files needed!)
        function playSound(type) {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'delete') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(80, audioCtx.currentTime + 0.25);
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.25);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.25);
                } else if (type === 'success') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, audioCtx.currentTime);
                    osc.frequency.setValueAtTime(660, audioCtx.currentTime + 0.1);
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.3);
                }
            } catch (e) {
                console.log('Audio Context not supported or blocked.');
            }
        }

        // Custom confirmation modal implementation
        function showCustomConfirm(message, onConfirm) {
            playSound('delete');
            const modal = document.getElementById('customConfirmModal');
            const msgEl = document.getElementById('confirmModalMessage');
            const okBtn = document.getElementById('confirmModalOkBtn');
            const cancelBtn = document.getElementById('confirmModalCancelBtn');

            msgEl.innerText = message;
            modal.style.display = 'flex';

            // Clean up previous event listeners
            const newOkBtn = okBtn.cloneNode(true);
            const newCancelBtn = cancelBtn.cloneNode(true);
            okBtn.parentNode.replaceChild(newOkBtn, okBtn);
            cancelBtn.parentNode.replaceChild(newCancelBtn, cancelBtn);

            document.getElementById('confirmModalOkBtn').addEventListener('click', () => {
                modal.style.display = 'none';
                playSound('success');
                if (onConfirm) onConfirm();
            });

            document.getElementById('confirmModalCancelBtn').addEventListener('click', () => {
                modal.style.display = 'none';
            });
        }

        function switchTab(tabId, element) {
            document.querySelectorAll('.admin-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));

            document.getElementById(tabId).classList.add('active');
            element.classList.add('active');

            const titles = {
                'dashboard': 'Dashboard Overview',
                'appointments': 'Appointments History',
                'deletedLogs': 'Deleted Appointment Logs Archive',
                'announcements': 'Clinic Announcements Manager',
                'clients': 'Registered Clients Directory',
                'pets': 'Pet Healthcare Records'
            };
            document.getElementById('pageTitle').innerText = titles[tabId];
            if (tabId === 'announcements') loadAdminAnnouncements();
            if (tabId === 'dashboard' || tabId === 'appointments') loadAdminAppointmentsTables();
            if (tabId === 'deletedLogs') loadDeletedLogsTable();
            if (tabId === 'pets') loadPetRecordsTable();
        }

        function loadAdminProfileInfo() {
            let profile = JSON.parse(localStorage.getItem('admin_profile_data') || '{"name": "System Administrator", "position": "Administrator Role"}');
            document.getElementById('sidebarAdminName').innerText = profile.name;
            document.getElementById('sidebarAdminPosition').innerText = profile.position;
            document.getElementById('headerAdminName').innerText = profile.name;

            let initials = profile.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'SA';
            document.getElementById('sidebarAvatar').innerText = initials;
        }

        function openAdminLoginModal() {
            let profile = JSON.parse(localStorage.getItem('admin_profile_data') || '{"name": "", "position": ""}');
            document.getElementById('loginAdminName').value = profile.name || '';
            document.getElementById('loginAdminPosition').value = profile.position || '';
            document.getElementById('adminLoginModal').style.display = 'flex';
        }

        function closeAdminLoginModal() {
            document.getElementById('adminLoginModal').style.display = 'none';
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            let name = document.getElementById('loginAdminName').value.trim();
            let position = document.getElementById('loginAdminPosition').value.trim();

            if (!name || !position) {
                alert('Please fill out both Name and Position fields.');
                return;
            }

            let profile = { name: name, position: position };
            localStorage.setItem('admin_profile_data', JSON.stringify(profile));

            loadAdminProfileInfo();
            closeAdminLoginModal();
            alert(`Welcome back, ${name} (${position})!`);
        }

        function openAdminProfileModal() {
            let profile = JSON.parse(localStorage.getItem('admin_profile_data') || '{"name": "System Administrator", "position": "Administrator Role"}');
            document.getElementById('editAdminName').value = profile.name;
            document.getElementById('editAdminPosition').value = profile.position;
            document.getElementById('adminProfileModal').style.display = 'flex';
        }

        function closeAdminProfileModal() {
            document.getElementById('adminProfileModal').style.display = 'none';
        }

        function saveAdminProfile() {
            let name = document.getElementById('editAdminName').value.trim();
            let position = document.getElementById('editAdminPosition').value.trim();

            if (!name) {
                alert('Admin name cannot be empty.');
                return;
            }

            let profile = { name: name, position: position || 'Administrator Role' };
            localStorage.setItem('admin_profile_data', JSON.stringify(profile));

            loadAdminProfileInfo();
            closeAdminProfileModal();
            alert('Admin profile updated successfully!');
        }

        function toggleDashboardSeeMore() {
            dashboardShowAll = !dashboardShowAll;
            loadAdminAppointmentsTables();
        }

        function toggleAppointmentsSeeMore() {
            appointmentsShowAll = !appointmentsShowAll;
            loadAdminAppointmentsTables();
        }

        function filterAppointmentsByStatus(status) {
            currentStatusFilter = status;

            document.querySelectorAll('.stat-card').forEach(card => card.classList.remove('active-filter'));
            if(status === 'Pending') document.getElementById('cardPending').classList.add('active-filter');
            else if(status === 'Confirmed') document.getElementById('cardConfirmed').classList.add('active-filter');
            else if(status === 'Cancelled') document.getElementById('cardCancelled').classList.add('active-filter');
            else document.getElementById('cardAll').classList.add('active-filter');

            const headerLabel = document.getElementById('tableCardHeaderLabel');
            const clearBtn = document.getElementById('clearFilterBtn');
            if(status === 'All') {
                headerLabel.innerText = 'Recent Appointments & Activity Updates';
                clearBtn.style.display = 'none';
            } else {
                headerLabel.innerText = `Filtered Appointments: ${status}`;
                clearBtn.style.display = 'inline-block';
            }

            loadAdminAppointmentsTables();
        }

        function sortDashboardTable(col) {
            if (dashboardSortCol === col) {
                dashboardSortDir = dashboardSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                dashboardSortCol = col;
                dashboardSortDir = 'asc';
            }
            updateSortIcons('dash', dashboardSortCol, dashboardSortDir);
            loadAdminAppointmentsTables();
        }

        function sortAppointmentsTable(col) {
            if (appointmentsSortCol === col) {
                appointmentsSortDir = appointmentsSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                appointmentsSortCol = col;
                appointmentsSortDir = 'asc';
            }
            updateSortIcons('appt', appointmentsSortCol, appointmentsSortDir);
            loadAdminAppointmentsTables();
        }

        function sortPetsTable(col) {
            if (petsSortCol === col) {
                petsSortDir = petsSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                petsSortCol = col;
                petsSortDir = 'asc';
            }
            updateSortIcons('pet', petsSortCol, petsSortDir);
            loadPetRecordsTable();
        }

        function updateSortIcons(tablePrefix, activeCol, dir) {
            let cols = ['clientName', 'petName', 'date'];
            cols.forEach(c => {
                let icon = document.getElementById(`sortIcon_${tablePrefix}_${c}`);
                if (icon) {
                    if (c === activeCol) {
                        icon.className = dir === 'asc' ? 'fa-solid fa-sort-up' : 'fa-solid fa-sort-down';
                        icon.style.color = 'var(--primary-accent)';
                    } else {
                        icon.className = 'fa-solid fa-sort';
                        icon.style.color = 'var(--text-muted)';
                    }
                }
            });
        }

        function loadAdminAppointmentsTables() {
            let serverAppointments = [];
            @if (appointments.Any())
            {
                    foreach (var item in appointments)
                    {
                            @:serverAppointments.push({ id: '@item.Id', rawTimestamp: @item.AppointmentDate.Ticks, clientName: '@item.ClientName', petName: '@item.PetName', service: '@item.Service', date: '@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")', status: '@item.Status' });
                    }
            }

            let localSchedules = JSON.parse(localStorage.getItem('local_pet_appointments') || '[]');

            let combinedOverrides = {};
            let generalOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides') || '{}');
            Object.assign(combinedOverrides, generalOverrides);

            let globalLogs = JSON.parse(localStorage.getItem('admin_appointment_logs') || '{}');
            Object.assign(combinedOverrides, globalLogs);

            for (let i = 0; i < localStorage.length; i++) {
                let key = localStorage.key(i);
                if (key && key.startsWith('appointment_status_overrides_')) {
                    try {
                        let clientOverrides = JSON.parse(localStorage.getItem(key) || '{}');
                        Object.assign(combinedOverrides, clientOverrides);
                    } catch(e) {}
                }
            }

            let deletedIds = JSON.parse(localStorage.getItem('admin_deleted_appointment_ids') || '[]');

            let combinedMap = {};
            serverAppointments.forEach(item => { if(!deletedIds.includes(String(item.id))) combinedMap[item.id] = item; });
            localSchedules.forEach(item => {
                if(!item.rawTimestamp) item.rawTimestamp = new Date(item.rawDate || Date.now()).getTime();
                if(!deletedIds.includes(String(item.id))) combinedMap[item.id] = item;
            });

            let allRecords = Object.values(combinedMap).map(item => {
                if (item.id && combinedOverrides[item.id]) {
                    item.status = combinedOverrides[item.id].status;
                    if (combinedOverrides[item.id].date) {
                        item.date = combinedOverrides[item.id].date;
                        item.rawTimestamp = new Date(combinedOverrides[item.id].rawDate || combinedOverrides[item.id].date).getTime();
                    }
                }
                return item;
            });

            let pCount = 0, cCount = 0, canCount = 0;
            allRecords.forEach(a => {
                let s = (a.status || '').toLowerCase();
                if (s === 'pending') pCount++;
                else if (s === 'confirmed' || s === 'approved') cCount++;
                else if (s === 'cancelled' || s === 'rejected') canCount++;
            });

            document.getElementById('statPendingCount').innerText = pCount;
            document.getElementById('statConfirmedCount').innerText = cCount;
            document.getElementById('statCancelledCount').innerText = canCount;
            document.getElementById('statTotalCount').innerText = allRecords.length;

            let filteredRecords = allRecords;
            if (currentStatusFilter !== 'All') {
                filteredRecords = allRecords.filter(a => {
                    let s = (a.status || '').toLowerCase();
                    if (currentStatusFilter === 'Confirmed') return s === 'confirmed' || s === 'approved';
                    if (currentStatusFilter === 'Cancelled') return s === 'cancelled' || s === 'rejected';
                    return s === currentStatusFilter.toLowerCase();
                });
            }

            let dashRecords = [...filteredRecords];
            dashRecords.sort((a, b) => {
                let valA, valB;
                if (dashboardSortCol === 'date') {
                    valA = a.rawTimestamp || new Date(a.date).getTime() || 0;
                    valB = b.rawTimestamp || new Date(b.date).getTime() || 0;
                } else {
                    valA = (a[dashboardSortCol] || '').toLowerCase();
                    valB = (b[dashboardSortCol] || '').toLowerCase();
                }
                if (valA < valB) return dashboardSortDir === 'asc' ? -1 : 1;
                if (valA > valB) return dashboardSortDir === 'asc' ? 1 : -1;
                return 0;
            });

            let dashboardBody = document.getElementById('dynamicDashboardAppointmentsBody');
            let dashboardSeeMoreContainer = document.getElementById('dashboardSeeMoreContainer');

            if (dashboardBody) {
                dashboardBody.innerHTML = '';
                if (dashRecords.length > 0) {
                    let limit = dashboardShowAll ? dashRecords.length : 5;
                    let visibleList = dashRecords.slice(0, limit);

                    visibleList.forEach(item => {
                        let badgeClass = (item.status || 'pending').toLowerCase();
                        let actionHtml = '';

                        if (item.status && item.status.toLowerCase() === 'pending') {
                            actionHtml = `
                                <button class="btn-action btn-approve" onclick="updateStatus('${item.id}', 'Confirmed')">Approve</button>
                                <button class="btn-action btn-reject" onclick="updateStatus('${item.id}', 'Rejected')">Reject</button>
                                <button class="btn-action btn-delete" onclick="promptDeleteAppointment('${item.id}')" title="Delete Record"><i class="fa-solid fa-trash"></i></button>
                            `;
                        } else {
                            actionHtml = `
                                <button class="btn-action btn-delete" onclick="promptDeleteAppointment('${item.id}')" title="Delete Record"><i class="fa-solid fa-trash"></i> Delete</button>
                            `;
                        }

                        dashboardBody.innerHTML += `
                            <tr>
                                <td><strong>${item.clientName}</strong></td>
                                <td>${item.petName}</td>
                                <td>${item.service}</td>
                                <td>${item.date}</td>
                                <td><span class="badge badge-${badgeClass}">${item.status}</span></td>
                                <td>${actionHtml}</td>
                            </tr>
                        `;
                    });

                    if (dashRecords.length > 5 && currentStatusFilter === 'All') {
                        dashboardSeeMoreContainer.innerHTML = `
                            <button class="see-more-toggle" onclick="toggleDashboardSeeMore()">
                                ${dashboardShowAll ? 'See Less ▲' : `See More (${dashRecords.length - 5} more) ▼`}
                            </button>
                        `;
                    } else {
                        dashboardSeeMoreContainer.innerHTML = '';
                    }
                } else {
                    dashboardBody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">No appointment records found for this filter.</td></tr>`;
                    dashboardSeeMoreContainer.innerHTML = '';
                }
            }

            let apptRecords = [...allRecords];
            apptRecords.sort((a, b) => {
                let valA, valB;
                if (appointmentsSortCol === 'date') {
                    valA = a.rawTimestamp || new Date(a.date).getTime() || 0;
                    valB = b.rawTimestamp || new Date(b.date).getTime() || 0;
                } else {
                    valA = (a[appointmentsSortCol] || '').toLowerCase();
                    valB = (b[appointmentsSortCol] || '').toLowerCase();
                }
                if (valA < valB) return appointmentsSortDir === 'asc' ? -1 : 1;
                if (valA > valB) return appointmentsSortDir === 'asc' ? 1 : -1;
                return 0;
            });

            let allAppointmentsBody = document.getElementById('dynamicAllAppointmentsBody');
            let appointmentsSeeMoreContainer = document.getElementById('appointmentsSeeMoreContainer');

            if (allAppointmentsBody) {
                allAppointmentsBody.innerHTML = '';
                if (apptRecords.length > 0) {
                    let limitAppt = appointmentsShowAll ? apptRecords.length : 8;
                    let visibleApptList = apptRecords.slice(0, limitAppt);

                    visibleApptList.forEach(item => {
                        let badgeClass = (item.status || 'pending').toLowerCase();
                        allAppointmentsBody.innerHTML += `
                            <tr>
                                <td>#APT-${item.id}</td>
                                <td><strong>${item.clientName}</strong></td>
                                <td>${item.petName}</td>
                                <td>${item.service}</td>
                                <td>${item.date}</td>
                                <td><span class="badge badge-${badgeClass}">${item.status}</span></td>
                                <td>
                                    <button class="btn-action btn-delete" onclick="promptDeleteAppointment('${item.id}')" title="Delete Record"><i class="fa-solid fa-trash"></i> Delete</button>
                                </td>
                            </tr>
                        `;
                    });

                    if (apptRecords.length > 8) {
                        appointmentsSeeMoreContainer.innerHTML = `
                            <button class="see-more-toggle" onclick="toggleAppointmentsSeeMore()">
                                ${appointmentsShowAll ? 'See Less ▲' : `See More (${apptRecords.length - 8} more) ▼`}
                            </button>
                        `;
                    } else {
                        appointmentsSeeMoreContainer.innerHTML = '';
                    }
                } else {
                    allAppointmentsBody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 24px;">No clinic appointments recorded.</td></tr>`;
                    appointmentsSeeMoreContainer.innerHTML = '';
                }
            }
        }

        // Trigger custom confirmation modal instead of native browser popup
        function promptDeleteAppointment(id) {
            showCustomConfirm('Are you sure you want to delete this appointment? It will be archived in Deleted Logs.', () => {
                deleteAppointmentAction(id);
            });
        }

        function deleteAppointmentAction(id) {
            let serverAppointments = [];
            @if (appointments.Any())
            {
                    foreach (var item in appointments)
                    {
                            @:serverAppointments.push({ id: '@item.Id', clientName: '@item.ClientName', petName: '@item.PetName', service: '@item.Service', date: '@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")', status: '@item.Status' });
                    }
            }
            let localSchedules = JSON.parse(localStorage.getItem('local_pet_appointments') || '[]');
            let all = [...serverAppointments, ...localSchedules];
            let target = all.find(a => String(a.id) === String(id));

            let deletedArchive = JSON.parse(localStorage.getItem('admin_deleted_appointment_logs') || '[]');
            let deletedIds = JSON.parse(localStorage.getItem('admin_deleted_appointment_ids') || '[]');

            if (target) {
                target.deletedAt = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                deletedArchive.unshift(target);
            }
            if (!deletedIds.includes(String(id))) {
                deletedIds.push(String(id));
            }

            localStorage.setItem('admin_deleted_appointment_logs', JSON.stringify(deletedArchive));
            localStorage.setItem('admin_deleted_appointment_ids', JSON.stringify(deletedIds));

            loadAdminAppointmentsTables();
            loadDeletedLogsTable();
            loadPetRecordsTable();
        }

        function loadDeletedLogsTable() {
            let deletedArchive = JSON.parse(localStorage.getItem('admin_deleted_appointment_logs') || '[]');
            let tbody = document.getElementById('dynamicDeletedLogsBody');

            if (tbody) {
                tbody.innerHTML = '';
                if (deletedArchive.length > 0) {
                    deletedArchive.forEach(item => {
                        let badgeClass = (item.status || 'pending').toLowerCase();
                        tbody.innerHTML += `
                            <tr>
                                <td><strong>${item.clientName}</strong></td>
                                <td>${item.petName}</td>
                                <td>${item.service}</td>
                                <td>${item.date || item.rawDate || 'N/A'}</td>
                                <td><span class="badge badge-${badgeClass}">${item.status || 'Unknown'}</span></td>
                                <td style="color: var(--text-muted); font-size: 0.8rem;">${item.deletedAt || 'Just now'}</td>
                            </tr>
                        `;
                    });
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">No deleted appointment records found in archive.</td></tr>`;
                }
            }
        }

        function clearDeletedLogsArchive() {
            showCustomConfirm('Are you sure you want to clear all archived deleted logs?', () => {
                localStorage.removeItem('admin_deleted_appointment_logs');
                loadDeletedLogsTable();
            });
        }

        function loadPetRecordsTable() {
            let serverAppointments = [];
            @if (appointments.Any())
            {
                    foreach (var item in appointments)
                    {
                            @:serverAppointments.push({ id: '@item.Id', clientName: '@item.ClientName', petName: '@item.PetName', service: '@item.Service', status: '@item.Status' });
                    }
            }

            let localSchedules = JSON.parse(localStorage.getItem('local_pet_appointments') || '[]');
            let deletedIds = JSON.parse(localStorage.getItem('admin_deleted_appointment_ids') || '[]');

            let combinedOverrides = {};
            let generalOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides') || '{}');
            Object.assign(combinedOverrides, generalOverrides);
            let globalLogs = JSON.parse(localStorage.getItem('admin_appointment_logs') || '{}');
            Object.assign(combinedOverrides, globalLogs);
            for (let i = 0; i < localStorage.length; i++) {
                let key = localStorage.key(i);
                if (key && key.startsWith('appointment_status_overrides_')) {
                    try {
                        let clientOverrides = JSON.parse(localStorage.getItem(key) || '{}');
                        Object.assign(combinedOverrides, clientOverrides);
                    } catch(e) {}
                }
            }

            let petHealthRecords = JSON.parse(localStorage.getItem('vet_pet_health_records') || '{}');

            let combinedMap = {};
            serverAppointments.forEach(item => { if(!deletedIds.includes(String(item.id))) combinedMap[item.id] = item; });
            localSchedules.forEach(item => { if(!deletedIds.includes(String(item.id))) combinedMap[item.id] = item; });

            let allRecords = Object.values(combinedMap).map(item => {
                if (item.id && combinedOverrides[item.id]) {
                    item.status = combinedOverrides[item.id].status;
                }
                return item;
            });

            let completedAppointments = allRecords.filter(a => {
                let s = (a.status || '').toLowerCase();
                return s === 'confirmed' || s === 'approved' || s === 'completed';
            });

            completedAppointments.sort((a, b) => {
                let valA = (a[petsSortCol] || '').toLowerCase();
                let valB = (b[petsSortCol] || '').toLowerCase();
                if (valA < valB) return petsSortDir === 'asc' ? -1 : 1;
                if (valA > valB) return petsSortDir === 'asc' ? 1 : -1;
                return 0;
            });

            let petRecordsBody = document.getElementById('dynamicPetRecordsBody');
            if (petRecordsBody) {
                petRecordsBody.innerHTML = '';
                if (completedAppointments.length > 0) {
                    completedAppointments.forEach(item => {
                        let recordKey = item.id || (item.petName + '_' + item.clientName);
                        let healthInfo = petHealthRecords[recordKey] || {
                            diagnosis: 'Healthy / Routine Check-up Completed',
                            vaccines: 'Anti-Rabies / Service Verified'
                        };

                        petRecordsBody.innerHTML += `
                            <tr>
                                <td><strong>${item.petName}</strong></td>
                                <td>${item.clientName}</td>
                                <td><span style="color: var(--primary-accent); font-weight: 500;">${item.service}</span></td>
                                <td>${healthInfo.diagnosis}</td>
                                <td><span class="badge badge-approved">${healthInfo.vaccines}</span></td>
                                <td>
                                    <button class="btn-action btn-primary-custom" onclick="openVetModal('${item.id || ''}', '${item.petName}', '${item.clientName}', '${healthInfo.diagnosis}', '${healthInfo.vaccines}')">
                                        <i class="fa-solid fa-notes-medical"></i> Update Record
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    petRecordsBody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">No completed or confirmed appointments available for pet record updates yet.</td></tr>`;
                }
            }
        }

        function openVetModal(id, petName, owner, diagnosis, vaccines) {
            document.getElementById('modalPetKey').value = id;
            document.getElementById('displayPetName').value = petName + " (Owner: " + owner + ")";
            document.getElementById('modalDiagnosis').value = diagnosis;
            document.getElementById('modalVaccines').value = vaccines;
            document.getElementById('vetModal').style.display = 'flex';
        }

        function closeVetModal() {
            document.getElementById('vetModal').style.display = 'none';
        }

        function saveHealthRecord() {
            let key = document.getElementById('modalPetKey').value;
            let diagnosis = document.getElementById('modalDiagnosis').value.trim();
            let vaccines = document.getElementById('modalVaccines').value.trim();

            if (!key) {
                alert('Invalid record identifier.');
                return;
            }

            let petHealthRecords = JSON.parse(localStorage.getItem('vet_pet_health_records') || '{}');
            petHealthRecords[key] = { diagnosis, vaccines };
            localStorage.setItem('vet_pet_health_records', JSON.stringify(petHealthRecords));

            playSound('success');
            alert('Pet health record successfully updated by veterinarian!');
            closeVetModal();
            loadPetRecordsTable();
        }

        const themeToggleBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const themeText = document.getElementById('themeText');

        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            themeIcon.className = 'fa-solid fa-sun';
            themeText.innerText = 'Light Mode';
        }

        themeToggleBtn.addEventListener('click', () => {
            let activeTheme = document.documentElement.getAttribute('data-theme');
            if (activeTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('theme', 'light');
                themeIcon.className = 'fa-solid fa-moon';
                themeText.innerText = 'Dark Mode';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeIcon.className = 'fa-solid fa-sun';
                themeText.innerText = 'Light Mode';
            }
        });

        async function updateStatus(id, newStatus) {
            playSound('success');
            let statusOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides') || '{}');
            statusOverrides[id] = { status: newStatus };
            localStorage.setItem('appointment_status_overrides', JSON.stringify(statusOverrides));

            let globalAdminLogs = JSON.parse(localStorage.getItem('admin_appointment_logs') || '{}');
            globalAdminLogs[id] = { status: newStatus };
            localStorage.setItem('admin_appointment_logs', JSON.stringify(globalAdminLogs));

            for (let i = 0; i < localStorage.length; i++) {
                let key = localStorage.key(i);
                if (key && key.startsWith('appointment_status_overrides_')) {
                    try {
                        let clientOverrides = JSON.parse(localStorage.getItem(key) || '{}');
                        clientOverrides[id] = { status: newStatus };
                        localStorage.setItem(key, JSON.stringify(clientOverrides));
                    } catch (e) {}
                }
            }

            try {
                const response = await fetch('/Home/UpdateAppointmentStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: id, status: newStatus })
                });

                const result = await response.json();
                loadAdminAppointmentsTables();
                loadPetRecordsTable();
            } catch (err) {
                console.error(err);
                loadAdminAppointmentsTables();
                loadPetRecordsTable();
            }
        }

        function postAnnouncement(e) {
            e.preventDefault();
            const title = document.getElementById('annTitle').value.trim();
            const content = document.getElementById('annContent').value.trim();
            const dateStr = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

            let list = JSON.parse(localStorage.getItem('clinic_announcements') || '[]');
            list.unshift({ title, content, date: dateStr });
            localStorage.setItem('clinic_announcements', JSON.stringify(list));

            playSound('success');
            alert('Announcement published successfully!');
            document.getElementById('annTitle').value = '';
            document.getElementById('annContent').value = '';
            loadAdminAnnouncements();
        }

        function loadAdminAnnouncements() {
            let list = JSON.parse(localStorage.getItem('clinic_announcements') || '[]');
            if (list.length === 0) {
                list = [{ title: 'Community Anti-Rabies Drive', content: 'Scheduled this Saturday at the Alaminos City Veterinary Office facility.', date: 'Nov 10, 2026' }];
                localStorage.setItem('clinic_announcements', JSON.stringify(list));
            }

            const container = document.getElementById('adminAnnouncementsList');
            container.innerHTML = '';
            list.forEach((ann, idx) => {
                container.innerHTML += `
                    <div style="background: var(--bg-main); padding: 14px; border-radius: 8px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <strong style="color: var(--text-heading); display: block; margin-bottom: 2px;">${ann.title}</strong>
                            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 4px;">${ann.content}</p>
                            <span style="font-size: 0.75rem; color: var(--primary-accent);">${ann.date}</span>
                        </div>
                        <button onclick="deleteAnnouncement(${idx})" class="btn-action btn-reject" style="padding: 4px 8px; font-size: 0.75rem;"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            });
        }

        function deleteAnnouncement(index) {
            playSound('delete');
            let list = JSON.parse(localStorage.getItem('clinic_announcements') || '[]');
            list.splice(index, 1);
            localStorage.setItem('clinic_announcements', JSON.stringify(list));
            loadAdminAnnouncements();
        }

        let isChatOpen = false;
        function toggleChatWindow() {
            isChatOpen = !isChatOpen;
            document.getElementById('chatWindow').style.display = isChatOpen ? 'flex' : 'none';
        }

        function handleChatKeyPress(event) {
            if (event.key === 'Enter') sendChatMessage();
        }

        async function sendChatMessage() {
            const inputField = document.getElementById('chatInput');
            const messageText = inputField.value.trim();
            if (!messageText) return;

            const chatMessages = document.getElementById('chatMessages');
            chatMessages.innerHTML += `<div style="background: var(--primary-accent); color: white; padding: 8px 12px; border-radius: 6px; max-width: 85%; align-self: flex-end; font-size: 13px;">${escapeHtml(messageText)}</div>`;
            inputField.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: messageText })
                });
                const data = await response.json();
                chatMessages.innerHTML += `<div style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; max-width: 85%; align-self: flex-start; font-size: 13px;">${data.reply}</div>`;
                chatMessages.scrollTop = chatMessages.scrollHeight;
            } catch (error) {
                chatMessages.innerHTML += `<div style="background: #fee2e2; color: #dc2626; padding: 8px 12px; border-radius: 6px; font-size: 13px;">Connection error.</div>`;
            }
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>