@model IEnumerable<MyPetcare.Models.User>
@{
    Layout = null;
    ViewData["Title"] = "MyPetcare - Admin Dashboard";

    // Retrieve the shared appointment list from ViewBag
    var appointments = ViewBag.Appointments as List<MyPetcare.Models.AppointmentModel> ?? new List<MyPetcare.Models.AppointmentModel>();

    // Retrieve the registered users list from the Model
    var users = Model ?? Enumerable.Empty<MyPetcare.Models.User>();

    // Calculate live summary statistics
    int pendingCount = appointments.Count(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));
    int confirmedCount = appointments.Count(a => a.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase));
    int totalAppointments = appointments.Count;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            /* Light Theme (Default) */
            --bg-main: #f4f6f9;
            --bg-card: #ffffff;
            --bg-sidebar: #1e293b;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --text-sidebar: #cbd5e1;
            --border-color: #e2e8f0;
            --header-bg: #ffffff;
            --primary-accent: #8b5cf6;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --table-hover: #f8fafc;
            --badge-pending-bg: #fef3c7;
            --badge-pending-text: #d97706;
            --badge-approved-bg: #d1fae5;
            --badge-approved-text: #059669;
            --badge-rejected-bg: #fee2e2;
            --badge-rejected-text: #dc2626;
        }

        [data-theme="dark"] {
            /* Deep Obsidian Cyber Dark Theme */
            --bg-main: #090d16;
            --bg-card: #131b2e;
            --bg-sidebar: #060911;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --text-sidebar: #94a3b8;
            --border-color: #1e293b;
            --header-bg: #131b2e;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --table-hover: #1e293b;
            --badge-pending-bg: #451a03;
            --badge-pending-text: #fbbf24;
            --badge-approved-bg: #064e3b;
            --badge-approved-text: #34d399;
            --badge-rejected-bg: #7f1d1d;
            --badge-rejected-text: #f87171;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: 260px;
            background-color: var(--bg-sidebar);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px 16px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #ffffff;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 32px;
            padding: 0 8px;
        }

            .brand i {
                color: #8b5cf6;
            }

        .nav-menu {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--text-sidebar);
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            position: relative;
            transition: all 0.25s ease;
        }

            .nav-link:hover, .nav-link.active {
                background-color: rgba(255, 255, 255, 0.1);
                color: #ffffff;
            }

                .nav-link.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 15%;
                    height: 70%;
                    width: 4px;
                    background: #8b5cf6;
                    border-radius: 0 4px 4px 0;
                    box-shadow: 0 0 8px #8b5cf6;
                }

        .logout-btn {
            background-color: #ef4444;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
        }

            .logout-btn:hover {
                background-color: #dc2626;
            }

        /* Main Content Container */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        /* Top Header Navigation */
        .header {
            background-color: var(--header-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* Theme Toggle Button */
        .theme-toggle-btn {
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .theme-toggle-btn:hover {
                border-color: var(--primary-accent);
            }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        .dashboard-body {
            padding: 32px;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        /* Views Sections with Smooth Animation */
        .admin-section {
            display: none;
        }

            .admin-section.active {
                display: flex;
                flex-direction: column;
                gap: 32px;
                animation: fadeInSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

        @@keyframes fadeInSlideUp {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Summary Stat Cards with Hover Lift */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

        .stat-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease;
            backdrop-filter: blur(12px);
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 24px -6px rgba(139, 92, 246, 0.25);
                border-color: rgba(139, 92, 246, 0.4);
            }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            background-color: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            transition: transform 0.3s ease;
        }

        .stat-card:hover .stat-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .stat-number {
            font-size: 1.8rem;
            font-weight: 800;
            line-height: 1.2;
        }

        .stat-label {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Tables and Cards */
        .table-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .table-card-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.95rem;
        }

        th {
            color: var(--text-muted);
            font-weight: 600;
        }

        tbody tr:hover {
            background-color: var(--table-hover);
        }

        /* Badges & Buttons with Animations */
        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.825rem;
            font-weight: 600;
            display: inline-block;
            text-transform: capitalize;
        }

        .badge-pending {
            background-color: var(--badge-pending-bg);
            color: var(--badge-pending-text);
            position: relative;
            box-shadow: 0 0 8px rgba(251, 191, 36, 0.3);
            animation: pulse-glow 2s infinite ease-in-out;
        }

        @@keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 4px rgba(251, 191, 36, 0.2);
            }

            50% {
                box-shadow: 0 0 12px rgba(251, 191, 36, 0.6);
            }
        }

        .badge-approved, .badge-confirmed {
            background-color: var(--badge-approved-bg);
            color: var(--badge-approved-text);
        }

        .badge-rejected, .badge-cancelled {
            background-color: var(--badge-rejected-bg);
            color: var(--badge-rejected-text);
        }

        .btn-action {
            padding: 6px 14px;
            border-radius: 6px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            font-size: 0.85rem;
            margin-right: 4px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-approve {
            background-color: #22c55e;
            color: white;
        }

            .btn-approve:hover {
                background-color: #16a34a;
                transform: translateY(-2px);
                box-shadow: 0 4px 14px rgba(34, 197, 94, 0.4);
            }

        .btn-reject {
            background-color: #ef4444;
            color: white;
        }

            .btn-reject:hover {
                background-color: #dc2626;
                transform: translateY(-2px);
                box-shadow: 0 4px 14px rgba(239, 68, 68, 0.4);
            }

        .btn-action:active {
            transform: translateY(0) scale(0.96);
        }

        .btn-primary-custom {
            background-color: #8b5cf6;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #7c3aed;
            }

        /* Floating Chatbot Bounce */
        #chatToggleBtn {
            animation: floatBounce 3s infinite ease-in-out;
        }

        @@keyframes floatBounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        #chatToggleBtn:hover {
            transform: scale(1.1) !important;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.5) !important;
        }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div>
            <div class="brand">
                <i class="fa-solid fa-paw"></i>
                <span>MyPetcare Admin</span>
            </div>
            <ul class="nav-menu">
                <li><a class="nav-link active" onclick="switchTab('dashboard', this)"><i class="fa-solid fa-house"></i> Dashboard</a></li>
                <li><a class="nav-link" onclick="switchTab('appointments', this)"><i class="fa-regular fa-calendar-check"></i> Appointments</a></li>
                <li><a class="nav-link" onclick="switchTab('clients', this)"><i class="fa-solid fa-users"></i> Clients</a></li>
                <li><a class="nav-link" onclick="switchTab('pets', this)"><i class="fa-solid fa-dog"></i> Pets Records & Health</a></li>
            </ul>
        </div>
        <button class="logout-btn" onclick="window.location.href='/Account/Logout'">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </button>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <header class="header">
            <h1 id="pageTitle" class="header-title">Admin Control Panel</h1>
            <div class="header-actions">
                <!-- Light / Dark Theme Switcher Button -->
                <button id="themeToggle" class="theme-toggle-btn">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                    <span id="themeText">Dark Mode</span>
                </button>
                <div class="user-profile">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Administrator / Vet</span>
                </div>
            </div>
        </header>

        <main class="dashboard-body">

            <!-- TAB 1: DASHBOARD OVERVIEW -->
            <section id="dashboard" class="admin-section active">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-calendar-days"></i></div>
                        <div>
                            <div class="stat-number">@pendingCount</div>
                            <div class="stat-label">Pending Appointments</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
                        <div>
                            <div class="stat-number">@confirmedCount</div>
                            <div class="stat-label">Confirmed Appointments</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-list-check"></i></div>
                        <div>
                            <div class="stat-number">@totalAppointments</div>
                            <div class="stat-label">Total Bookings</div>
                        </div>
                    </div>
                </div>

                <div class="table-card">
                    <h2 class="table-card-title">Recent Appointment Requests</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Client Name</th>
                                <th>Pet Name</th>
                                <th>Service Type</th>
                                <th>Date & Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (appointments.Any())
                            {
                                foreach (var item in appointments)
                                {
                                    <tr>
                                        <td><strong>@item.ClientName</strong></td>
                                        <td>@item.PetName</td>
                                        <td>@item.Service</td>
                                        <td>@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                        <td>
                                            <span class="badge badge-@item.Status.ToLower()">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button class="btn-action btn-approve" onclick="updateStatus(@item.Id, 'Confirmed')">Approve</button>
                                                <button class="btn-action btn-reject" onclick="updateStatus(@item.Id, 'Rejected')">Reject</button>
                                            }
                                            else
                                            {
                                                <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Processed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--text-muted);">No appointment requests found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 2: APPOINTMENTS -->
            <section id="appointments" class="admin-section">
                <div class="table-card">
                    <h2 class="table-card-title">All Clinic Appointments</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th>Client</th>
                                <th>Pet</th>
                                <th>Service</th>
                                <th>Schedule</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (appointments != null && appointments.Any())
                            {
                                foreach (var item in appointments)
                                {
                                    <tr>
                                        <td>#APT-@item.Id</td>
                                        <td><strong>@item.ClientName</strong></td>
                                        <td>@item.PetName</td>
                                        <td>@item.Service</td>
                                        <td>@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                        <td>
                                            <span class="badge badge-@item.Status.ToLower()">
                                                @item.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--text-muted);">
                                        No clinic appointments recorded.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 3: CLIENTS -->
            <section id="clients" class="admin-section">
                <div class="table-card">
                    <h2 class="table-card-title">Registered Client Directory</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Client ID</th>
                                <th>Full Name</th>
                                <th>Email Address</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (users.Any())
                            {
                                int rowId = 1;
                                foreach (var user in users)
                                {
                                    <tr>
                                        <td>@rowId</td>
                                        <td><strong>@user.FullName</strong></td>
                                        <td>@user.Email</td>
                                        <td>
                                            <span class="badge @(user.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase) ? "badge-approved" : "badge-pending")">
                                                @user.Role
                                            </span>
                                        </td>
                                    </tr>
                                    rowId++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center; color: var(--text-muted);">No registered clients found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 4: PETS RECORDS & HEALTHCARE UPDATE -->
            <section id="pets" class="admin-section">
                <div class="table-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h2 class="table-card-title" style="margin-bottom: 0;">Pets Medical & Healthcare Records</h2>
                        <span style="font-size: 0.9rem; color: var(--text-muted);">Veterinary Update Module</span>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Pet Name</th>
                                <th>Species/Breed</th>
                                <th>Owner</th>
                                <th>Latest Diagnosis</th>
                                <th>Vaccination Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Max</strong></td>
                                <td>Corgi (Dog)</td>
                                <td>Emelyn Radovan</td>
                                <td>Healthy / Annual Check-up</td>
                                <td>Anti-Rabies (Updated)</td>
                                <td>
                                    <button class="btn-action btn-primary-custom" onclick="openVetModal('Max', 'Corgi (Dog)', 'Emelyn Radovan')">
                                        <i class="fa-solid fa-notes-medical"></i> Update Health Record
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Luna</strong></td>
                                <td>Domestic (Cat)</td>
                                <td>Emelyn Radovan</td>
                                <td>General Check-up Needed</td>
                                <td>Vaccinated ✓</td>
                                <td>
                                    <button class="btn-action btn-primary-custom" onclick="openVetModal('Luna', 'Domestic (Cat)', 'Emelyn Radovan')">
                                        <i class="fa-solid fa-notes-medical"></i> Update Health Record
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

        </main>
    </div>

    <!-- VET HEALTHCARE UPDATE MODAL -->
    <div id="vetModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:999; justify-content:center; align-items:center;">
        <div style="background:var(--bg-card); padding:30px; border-radius:12px; width:450px; border:1px solid var(--border-color); color:var(--text-main);">
            <h3 style="margin-bottom:16px;">🩺 Update Pet Healthcare Record</h3>

            <input type="hidden" id="modalPetName" />

            <div style="margin-bottom:12px;">
                <label style="font-size:0.85rem; font-weight:600;">Pet Name:</label>
                <input type="text" id="displayPetName" disabled style="width:100%; padding:8px; margin-top:4px; border-radius:6px; border:1px solid var(--border-color); background:var(--bg-main); color:var(--text-main);" />
            </div>

            <div style="margin-bottom:12px;">
                <label style="font-size:0.85rem; font-weight:600;">Diagnosis / Condition:</label>
                <input type="text" id="modalDiagnosis" placeholder="e.g. Healthy, Mild Fever, Deworming Needed" style="width:100%; padding:8px; margin-top:4px; border-radius:6px; border:1px solid var(--border-color); background:var(--bg-main); color:var(--text-main);" />
            </div>

            <div style="margin-bottom:12px;">
                <label style="font-size:0.85rem; font-weight:600;">Vaccines / Medication Given:</label>
                <input type="text" id="modalVaccines" placeholder="e.g. 5-in-1, Anti-Rabies" style="width:100%; padding:8px; margin-top:4px; border-radius:6px; border:1px solid var(--border-color); background:var(--bg-main); color:var(--text-main);" />
            </div>

            <div style="margin-bottom:12px;">
                <label style="font-size:0.85rem; font-weight:600;">Weight (kg):</label>
                <input type="number" step="0.1" id="modalWeight" placeholder="e.g. 8.5" style="width:100%; padding:8px; margin-top:4px; border-radius:6px; border:1px solid var(--border-color); background:var(--bg-main); color:var(--text-main);" />
            </div>

            <div style="margin-bottom:20px;">
                <label style="font-size:0.85rem; font-weight:600;">Vet Notes & Recommendations:</label>
                <textarea id="modalNotes" rows="3" placeholder="Additional treatment instructions..." style="width:100%; padding:8px; margin-top:4px; border-radius:6px; border:1px solid var(--border-color); background:var(--bg-main); color:var(--text-main);"></textarea>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button onclick="closeVetModal()" style="padding:8px 16px; border-radius:6px; border:1px solid var(--border-color); background:transparent; color:var(--text-main); cursor:pointer;">Cancel</button>
                <button onclick="saveHealthRecord()" style="padding:8px 16px; border-radius:6px; border:none; background:#8b5cf6; color:white; font-weight:600; cursor:pointer;">Save Record</button>
            </div>
        </div>
    </div>

    <!-- FLOATING AI CHATBOT WIDGET -->
    <div id="aiChatWidget" style="position: fixed; bottom: 24px; right: 24px; z-index: 10000; font-family: Arial, Helvetica, sans-serif;">
        <button id="chatToggleBtn" onclick="toggleChatWindow()" style="width: 65px; height: 65px; border-radius: 50%; background: #ffffff; border: 2px solid #3b82f6; cursor: pointer; box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3); display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 0;">
            <img src="/images/chatbotLogo.jpg" alt="PetBot AI" style="width: 100%; height: 100%; object-fit: cover;" />
        </button>

        <div id="chatWindow" style="display: none; position: absolute; bottom: 80px; right: 0; width: 360px; height: 490px; background-color: var(--bg-card, #ffffff); border: 1px solid var(--border-color, #e2e8f0); border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); flex-direction: column; overflow: hidden; color: var(--text-main, #000000);">
            <div style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: white; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <img src="/images/chatbotLogo.jpg" alt="PetBot Logo" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 2px solid white;" />
                    <div>
                        <h4 style="margin: 0; font-size: 1rem; font-weight: 700;">PetBot AI</h4>
                        <span style="font-size: 0.75rem; opacity: 0.9; color: #dbeafe;">Online | AI Veterinary Assistant</span>
                    </div>
                </div>
                <button onclick="toggleChatWindow()" style="background: transparent; border: none; color: white; font-size: 1.2rem; cursor: pointer;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div id="chatMessages" style="flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem; background-color: var(--bg-main, #f8fafc);">
                <div style="background: #eff6ff; color: #1e3a8a; padding: 10px 14px; border-radius: 12px; max-width: 85%; align-self: flex-start; border-left: 3px solid #3b82f6; line-height: 1.4;">
                    Hello! I am <strong>PetBot</strong> 🐾 Ask me any questions about animal health, vaccinations, or clinic hours!
                </div>
            </div>

            <div style="padding: 12px; border-top: 1px solid var(--border-color, #e2e8f0); display: flex; gap: 8px; background-color: var(--bg-card, #ffffff);">
                <input type="text" id="chatInput" placeholder="Ask PetBot about pet care..." onkeypress="handleChatKeyPress(event)" style="flex: 1; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color, #cbd5e1); background-color: var(--bg-card, #ffffff); color: var(--text-main, #000000); font-size: 0.9rem; outline: none;" />
                <button onclick="sendChatMessage()" style="background-color: #2563eb; color: white; border: none; padding: 0 16px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT FUNCTIONS -->
    <script>
        // Tab Switcher
        function switchTab(tabId, element) {
            document.querySelectorAll('.admin-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));

            document.getElementById(tabId).classList.add('active');
            element.classList.add('active');

            const titles = {
                'dashboard': 'Admin Control Panel',
                'appointments': 'Appointments Management',
                'clients': 'Registered Clients',
                'pets': 'Pets Records & Healthcare'
            };
            document.getElementById('pageTitle').innerText = titles[tabId];
        }

        // Theme Toggle Handler
        const themeToggleBtn = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const themeText = document.getElementById('themeText');

        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            themeIcon.className = 'fa-solid fa-sun';
            themeText.innerText = 'Light Mode';
        }

        themeToggleBtn.addEventListener('click', () => {
            let activeTheme = document.documentElement.getAttribute('data-theme');
            if (activeTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('theme', 'light');
                themeIcon.className = 'fa-solid fa-moon';
                themeText.innerText = 'Dark Mode';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeIcon.className = 'fa-solid fa-sun';
                themeText.innerText = 'Light Mode';
            }
        });

        // Appointment Status Update Handler (Approve / Reject)
        async function updateStatus(id, newStatus) {
            try {
                const response = await fetch('/Home/UpdateAppointmentStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: id, status: newStatus })
                });

                const result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to update status.');
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred while communicating with the server.');
            }
        }

        // Animated Stat Counters on Load
        document.addEventListener("DOMContentLoaded", () => {
            const counters = document.querySelectorAll('.stat-number');
            counters.forEach(counter => {
                const target = +counter.innerText;
                if (isNaN(target)) return;

                let count = 0;
                const speed = Math.max(1, Math.ceil(target / 20));

                const updateCount = () => {
                    count += speed;
                    if (count < target) {
                        counter.innerText = count;
                        setTimeout(updateCount, 40);
                    } else {
                        counter.innerText = target;
                    }
                };
                updateCount();
            });
        });

        // Vet Healthcare Modal Handlers
        function openVetModal(petName, species, owner) {
            document.getElementById('modalPetName').value = petName;
            document.getElementById('displayPetName').value = petName + " (" + species + " - Owner: " + owner + ")";
            document.getElementById('vetModal').style.display = 'flex';
        }

        function closeVetModal() {
            document.getElementById('vetModal').style.display = 'none';
        }

        function saveHealthRecord() {
            alert('Pet health record updated successfully!');
            closeVetModal();
        }

        // Chatbot Window Toggle
        function toggleChatWindow() {
            const win = document.getElementById('chatWindow');
            win.style.display = win.style.display === 'flex' ? 'none' : 'flex';
        }

        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if(!msg) return;

            const chatMessages = document.getElementById('chatMessages');
            chatMessages.innerHTML += `<div style="background: #2563eb; color: white; padding: 10px 14px; border-radius: 12px; max-width: 85%; align-self: flex-end; line-height: 1.4;">${msg}</div>`;
            input.value = '';

            setTimeout(() => {
                chatMessages.innerHTML += `<div style="background: #eff6ff; color: #1e3a8a; padding: 10px 14px; border-radius: 12px; max-width: 85%; align-self: flex-start; border-left: 3px solid #3b82f6; line-height: 1.4;">Thank you for your question! Our veterinary team will assist you shortly. 🐾</div>`;
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }, 1000);
        }

        function handleChatKeyPress(e) {
            if(e.key === 'Enter') sendChatMessage();
        }
    </script>
</body>
</html>