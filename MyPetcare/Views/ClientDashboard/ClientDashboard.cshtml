    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Load Saved Profile Preferences and Character SVG on Startup
        document.addEventListener("DOMContentLoaded", () => {
            const savedName = localStorage.getItem('client_displayName');
            if (savedName) document.getElementById('headerDisplayName').innerText = savedName;

            const savedHeaderSvg = localStorage.getItem('header_pet_svg');
            if (savedHeaderSvg) {
                document.getElementById('headerPetSvg').innerHTML = savedHeaderSvg;
                document.getElementById('canvaPetSvg').innerHTML = savedHeaderSvg;
            }
        });

        // Theme Toggle Logic
        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.getElementById('themeIcon').className = "fa-solid fa-sun";
            document.getElementById('themeText').innerText = "Light Mode";
        }

        function toggleTheme() {
            const root = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');

            if (root.getAttribute('data-theme') === 'dark') {
                root.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                themeIcon.className = "fa-solid fa-moon";
                themeText.innerText = "Dark Mode";
            } else {
                root.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeIcon.className = "fa-solid fa-sun";
                themeText.innerText = "Light Mode";
            }
        }

        // -------------------------------------------------------------
        // CANVA-STYLE MULTI-ANIMAL CHARACTER CREATOR ENGINE
        // -------------------------------------------------------------
        let currentSpecies = "dog";
        let currentFurColor = "#d97706";
        let currentOutfitColor = "#ef4444";

        function setSpecies(species) {
            currentSpecies = species;
            const earsLayer = document.getElementById('svgEarsLayer');
            const tailLayer = document.getElementById('svgTailLayer');
            const muzzleLayer = document.getElementById('svgMuzzleLayer');
            const darkerColor = adjustColorBrightness(currentFurColor, -25);

            if (species === 'cat') {
                earsLayer.innerHTML = `
                    <path d="M 75 68 L 58 35 L 85 58 Z" fill="${darkerColor}" />
                    <path d="M 125 68 L 142 35 L 115 58 Z" fill="${darkerColor}" />
                    <path d="M 72 63 L 62 42 L 80 57 Z" fill="#f472b6" />
                    <path d="M 128 63 L 138 42 L 120 57 Z" fill="#f472b6" />
                `;
                tailLayer.innerHTML = `
                    <path d="M 50 120 Q 20 140 25 100 Q 30 80 20 70" stroke="${currentFurColor}" stroke-width="6" stroke-linecap="round" fill="none" />
                `;
                muzzleLayer.innerHTML = `
                    <ellipse cx="100" cy="94" rx="12" ry="9" fill="#fef3c7" />
                    <ellipse cx="100" cy="91" rx="3.5" ry="2.5" fill="#0f172a" />
                    <line x1="65" y1="90" x2="85" y2="92" stroke="#0f172a" stroke-width="1.5" />
                    <line x1="65" y1="96" x2="85" y2="95" stroke="#0f172a" stroke-width="1.5" />
                    <line x1="135" y1="90" x2="115" y2="92" stroke="#0f172a" stroke-width="1.5" />
                    <line x1="135" y1="96" x2="115" y2="95" stroke="#0f172a" stroke-width="1.5" />
                `;
            } else if (species === 'rabbit') {
                earsLayer.innerHTML = `
                    <ellipse cx="78" cy="40" rx="8" ry="32" fill="${currentFurColor}" />
                    <ellipse cx="122" cy="40" rx="8" ry="32" fill="${currentFurColor}" />
                    <ellipse cx="78" cy="40" rx="4" ry="24" fill="#f472b6" />
                    <ellipse cx="122" cy="40" rx="4" ry="24" fill="#f472b6" />
                `;
                tailLayer.innerHTML = `
                    <circle cx="45" cy="125" r="12" fill="#ffffff" />
                `;
                muzzleLayer.innerHTML = `
                    <ellipse cx="100" cy="94" rx="12" ry="9" fill="#fef3c7" />
                    <ellipse cx="100" cy="91" rx="4" ry="2.5" fill="#0f172a" />
                `;
            } else if (species === 'bird') {
                earsLayer.innerHTML = `
                    <path d="M 95 60 Q 100 40 108 45 Q 100 55 98 60 Z" fill="${darkerColor}" />
                `;
                tailLayer.innerHTML = `
                    <path d="M 45 115 L 25 105 L 30 120 L 20 130 Z" fill="${currentFurColor}" />
                `;
                muzzleLayer.innerHTML = `
                    <polygon points="100,86 92,94 108,94" fill="#f59e0b" />
                `;
            } else {
                // Default Dog
                earsLayer.innerHTML = `
                    <path id="svgEarLeft" d="M 75 75 Q 55 60 65 85 Z" fill="${darkerColor}" />
                    <path id="svgEarRight" d="M 125 75 Q 145 60 135 85 Z" fill="${darkerColor}" />
                `;
                tailLayer.innerHTML = `
                    <path d="M 50 110 Q 30 95 40 80" stroke="${currentFurColor}" stroke-width="8" stroke-linecap="round" fill="none" />
                `;
                muzzleLayer.innerHTML = `
                    <ellipse cx="100" cy="94" rx="14" ry="11" fill="#fef3c7" />
                    <ellipse cx="100" cy="91" rx="4.5" ry="3" fill="#0f172a" />
                    <path d="M 100 94 Q 96 101 93 98" stroke="#0f172a" stroke-width="1.5" fill="none" stroke-linecap="round" />
                    <path d="M 100 94 Q 104 101 107 98" stroke="#0f172a" stroke-width="1.5" fill="none" stroke-linecap="round" />
                    <path d="M 97 99 Q 100 106 103 99 Z" fill="#f43f5e" />
                `;
            }
        }

        function setFurColor(hex) {
            currentFurColor = hex;
            document.getElementById('svgBody').setAttribute('fill', hex);
            document.getElementById('svgHead').setAttribute('fill', hex);
            setSpecies(currentSpecies);
        }

        function setEars(style) {
            if (style === 'floppy' && currentSpecies === 'dog') {
                document.getElementById('svgEarsLayer').innerHTML = `<path d="M 72 72 Q 45 70 60 95 Z" fill="${adjustColorBrightness(currentFurColor, -25)}" /><path d="M 128 72 Q 155 70 140 95 Z" fill="${adjustColorBrightness(currentFurColor, -25)}" />`;
            } else if (style === 'pointed') {
                setSpecies(currentSpecies);
            }
        }

        function setExpression(exp) {
            const eyesGroup = document.getElementById('svgEyes');
            if (exp === 'happy') {
                eyesGroup.innerHTML = `
                    <circle cx="91" cy="79" r="3.5" fill="#0f172a" />
                    <circle cx="109" cy="79" r="3.5" fill="#0f172a" />
                    <circle cx="92" cy="78" r="1" fill="#ffffff" />
                    <circle cx="110" cy="78" r="1" fill="#ffffff" />
                `;
            } else if (exp === 'wink') {
                eyesGroup.innerHTML = `
                    <path d="M 87 79 Q 91 74 95 79" stroke="#0f172a" stroke-width="2.5" fill="none" stroke-linecap="round" />
                    <circle cx="109" cy="79" r="3.5" fill="#0f172a" />
                    <circle cx="110" cy="78" r="1" fill="#ffffff" />
                `;
            } else if (exp === 'cool') {
                eyesGroup.innerHTML = `
                    <rect x="84" y="74" width="32" height="9" rx="3" fill="#0f172a" />
                    <line x1="91" y1="74" x2="109" y2="74" stroke="#475569" stroke-width="2" />
                `;
            }
        }

        function setOutfit(style) {
            const outfitGroup = document.getElementById('svgOutfitGroup');
            if (style === 'none') {
                outfitGroup.style.display = 'none';
            } else if (style === 'tee') {
                outfitGroup.style.display = 'block';
                outfitGroup.innerHTML = `
                    <path d="M 68 100 Q 100 90 132 100 L 140 135 Q 100 142 60 135 Z" fill="${currentOutfitColor}" />
                    <circle cx="64" cy="112" r="10" fill="${currentOutfitColor}" />
                    <circle cx="136" cy="112" r="10" fill="${currentOutfitColor}" />
                `;
            } else if (style === 'dress') {
                outfitGroup.style.display = 'block';
                outfitGroup.innerHTML = `
                    <path d="M 72 98 L 128 98 L 148 145 L 52 145 Z" fill="${currentOutfitColor}" />
                `;
            }
        }

        function setOutfitColor(hex) {
            currentOutfitColor = hex;
            document.querySelectorAll('#svgOutfitGroup path, #svgOutfitGroup circle').forEach(el => el.setAttribute('fill', hex));
        }

        function setCap(style) {
            const capGroup = document.getElementById('svgCapGroup');
            if (style === 'none') {
                capGroup.style.display = 'none';
            } else if (style === 'cap') {
                capGroup.style.display = 'block';
                capGroup.innerHTML = `
                    <path d="M 72 70 Q 100 45 128 70 L 145 65 Q 100 35 55 65 Z" fill="#2563eb" />
                    <ellipse cx="100" cy="62" rx="28" ry="7" fill="#1d4ed8" />
                    <rect x="95" y="52" width="10" height="4" fill="#fbbf24" />
                `;
            } else if (style === 'bow') {
                capGroup.style.display = 'block';
                capGroup.innerHTML = `
                    <circle cx="100" cy="55" r="7" fill="#db2777" />
                    <polygon points="93,52 82,46 84,60" fill="#f472b6" />
                    <polygon points="107,52 118,46 116,60" fill="#f472b6" />
                `;
            }
        }

        function adjustColorBrightness(hex, percent) {
            let num = parseInt(hex.replace("#",""), 16);
            let amt = Math.round(2.55 * percent);
            let R = (num >> 16) + amt;
            let G = (num >> 8 & 0x00FF) + amt;
            let B = (num & 0x0000FF) + amt;
            return "#" + (0x1000000 + (R<255?R<0?0:R:255)*0x10000 + (G<255?G<0?0:G:255)*0x100 + (B<255?B<0?0:B:255)).toString(16).slice(1);
        }

        function openProfileModal() {
            document.getElementById('profileModal').style.display = 'flex';
        }

        function closeProfileModal() {
            document.getElementById('profileModal').style.display = 'none';
        }

        function saveProfileChanges() {
            const newName = document.getElementById('modalDisplayName').value.trim();
            if (newName) {
                document.getElementById('headerDisplayName').innerText = newName;
                localStorage.setItem('client_displayName', newName);
            }

            const canvaSvgHtml = document.getElementById('canvaPetSvg').innerHTML;
            document.getElementById('headerPetSvg').innerHTML = canvaSvgHtml;
            localStorage.setItem('header_pet_svg', canvaSvgHtml);

            closeProfileModal();
        }

        // -------------------------------------------------------------
        // FRIENDS & VISITING LOGIC
        // -------------------------------------------------------------
        async function openFriendsModal() {
            document.getElementById('friendsModal').style.display = 'flex';
            const userEmail = "@ViewBag.UserEmail";
            const container = document.getElementById('friendsListContainer');

            try {
                const res = await fetch(`/Account/GetFriendsList?userEmail=${encodeURIComponent(userEmail)}`);
                const data = await res.json();

                if (data.success && data.friends.length > 0) {
                    container.innerHTML = data.friends.map(f => `
                        <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-main); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="display: flex; align-items: center; gap: 10px; text-align: left;">
                                <div style="width: 36px; height: 36px; border-radius: 50%; background: #fff; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 1px solid var(--primary-accent);">
                                    <svg viewBox="0 0 200 200" width="30" height="30">
                                        ${extractSvgInnerHtml(f.avatarJson)}
                                    </svg>
                                </div>
                                <div>
                                    <strong style="font-size: 13px; display: block; color: var(--heading-color);">${escapeHtml(f.name)}</strong>
                                    <span style="font-size: 11px; color: var(--text-muted);">${escapeHtml(f.email)}</span>
                                </div>
                            </div>
                            <button class="action-btn" onclick="visitFriendProfile('${escapeHtml(f.name)}', '${encodeURIComponent(f.avatarJson || '')}')" style="padding: 6px 12px; font-size: 12px;">Visit Pet 🐾</button>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = `<p style="font-size: 13px; color: var(--text-muted); padding: 10px;">No friends added yet. Enter an email above to connect!</p>`;
                }
            } catch (err) {
                console.error(err);
                container.innerHTML = `<p style="font-size: 13px; color: #dc2626;">Error loading friends list.</p>`;
            }
        }

        async function sendFriendRequest() {
            const friendEmail = document.getElementById('friendEmailInput').value.trim();
            if (!friendEmail) return;

            try {
                const res = await fetch('/Account/AddFriend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ UserEmail: "@ViewBag.UserEmail", FriendEmail: friendEmail })
                });
                const data = await res.json();
                alert(data.message);
                if (data.success) {
                    document.getElementById('friendEmailInput').value = '';
                    openFriendsModal();
                }
            } catch (err) {
                console.error(err);
                alert('Failed to send friend request.');
            }
        }

              let currentVisitingEmail = '';

        async function visitFriendPet(friendEmail) {
            try {
                currentVisitingEmail = friendEmail;
                const response = await fetch(`/Home/GetFriendProfile?email=${encodeURIComponent(friendEmail)}`);
                const data = await response.json();

                if (data.success) {
                    // Update modal title
                    document.getElementById('visitingFriendTitleName').innerText = `${data.name}'s Pet & Profile`;

                    // Set up the full account redirect button action
                    const visitAccountBtn = document.getElementById('visitFullAccountBtn');
                    visitAccountBtn.onclick = function() {
                        // Redirect to a dedicated public profile or client dashboard view for this friend
                        window.location.href = `/Home/ClientDashboard?name=${encodeURIComponent(data.name)}&viewingEmail=${encodeURIComponent(friendEmail)}`;
                    };

                    // Show the modal
                    document.getElementById('friendVisitingModal').style.display = 'flex';
                } else {
                    alert(data.message);
                }
            } catch (error) {
                console.error("Error loading friend profile:", error);
                alert("Failed to visit friend's account.");
            }
        }

        function closeVisitingModal() {
            document.getElementById('friendVisitingModal').style.display = 'none';
        }

        // Appointment Modal Functions
        function openAppointmentModal() {
            document.getElementById('appointmentModal').style.display = 'flex';
        }

        function closeAppointmentModal() {
            document.getElementById('appointmentModal').style.display = 'none';
            document.getElementById('appointmentForm').reset();
        }
                async function sendFriendRequest() {
            // Fallback to localStorage if ViewBag is empty
            const userEmail = "@ViewBag.UserEmail" || localStorage.getItem('client_email');
            const friendEmail = document.getElementById('friendEmailInput').value.trim();

            if (!userEmail) {
                alert("User email not found. Please log in again.");
                return;
            }
            if (!friendEmail) return;

            try {
                const res = await fetch('/Account/AddFriend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ UserEmail: userEmail, FriendEmail: friendEmail })
                });
                const data = await res.json();
                alert(data.message);
                if (data.success) {
                    document.getElementById('friendEmailInput').value = '';
                    openFriendsModal();
                }
            } catch (err) {
                console.error(err);
                alert('Failed to send friend request.');
            }
        }

        // Appointment Submission Logic
        async function submitAppointment(event) {
            event.preventDefault();

            const petNameVal = document.getElementById('modalPetName').value.trim();
            const petBreedVal = document.getElementById('modalPetBreed').value.trim();
            const service = document.getElementById('modalService').value;
            const appointmentDate = document.getElementById('modalDateTime').value;

            const formattedPetName = `${petNameVal} (${petBreedVal})`;

            const payload = {
                ClientName: document.getElementById('headerDisplayName').innerText,
                PetName: formattedPetName,
                Service: service,
                AppointmentDate: appointmentDate
            };

            try {
                const response = await fetch('/Home/CreateAppointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.success) {
                    alert(data.message);
                    closeAppointmentModal();
                    location.reload();
                } else {
                    alert(data.message || 'Error creating appointment.');
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred while booking the appointment.');
            }
        }

        // Chatbot Logic
        let isChatOpen = false;

        function toggleChatWindow() {
            isChatOpen = !isChatOpen;
            const chatWindow = document.getElementById('chatWindow');
            chatWindow.style.display = isChatOpen ? 'flex' : 'none';
        }

        function handleChatKeyPress(event) {
            if (event.key === 'Enter') {
                sendChatMessage();
            }
        }

        async function sendChatMessage() {
            const inputField = document.getElementById('chatInput');
            const messageText = inputField.value.trim();
            if (!messageText) return;

            const chatMessages = document.getElementById('chatMessages');

            chatMessages.innerHTML += `
                <div style="background: var(--primary-accent); color: #ffffff; padding: 12px 16px; border-radius: 14px; border-bottom-right-radius: 4px; max-width: 85%; align-self: flex-end; box-shadow: 0 2px 5px rgba(0,0,0,0.05); line-height: 1.4;">
                    ${escapeHtml(messageText)}
                </div>
            `;
            inputField.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: messageText })
                });

                const data = await response.json();

                chatMessages.innerHTML += `
                    <div style="background: var(--card-bg); color: var(--heading-color); padding: 12px 16px; border-radius: 14px; border-bottom-left-radius: 4px; max-width: 85%; align-self: flex-start; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 4px solid var(--primary-accent); line-height: 1.4;">
                        ${data.reply}
                    </div>
                `;
                chatMessages.scrollTop = chatMessages.scrollHeight;
            } catch (error) {
                chatMessages.innerHTML += `
                    <div style="background: #fee2e2; color: #dc2626; padding: 12px 16px; border-radius: 14px; max-width: 85%; align-self: flex-start; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
                        Error connecting to PetBot. Please try again.
                    </div>
                `;
            }
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>