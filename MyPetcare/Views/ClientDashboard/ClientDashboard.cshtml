@{
    ViewData["Title"] = "Client Dashboard - PetCare Service Site";
    Layout = null;

    var clientAppointments = ViewBag.Appointments as List<MyPetcare.Models.AppointmentModel> ?? new List<MyPetcare.Models.AppointmentModel>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #f1f5f9;
            --card-bg: #ffffff;
            --text-color: #334155;
            --text-muted: #64748b;
            --heading-color: #0f172a;
            --border-color: #e2e8f0;
            --sidebar-bg: #ffffff;
            --table-border: #f1f5f9;
            --bg-main: #f8fafc;
            --primary-accent: #0284c7;
            --card-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
            --table-hover: #f8fafc;
            --badge-pending-bg: #fef3c7;
            --badge-pending-text: #b45309;
            --badge-approved-bg: #d1fae5;
            --badge-approved-text: #047857;
            --badge-rejected-bg: #fee2e2;
            --badge-rejected-text: #b91c1c;
        }

        [data-theme="dark"] {
            --bg-color: #0b0f19;
            --card-bg: #111827;
            --text-color: #9ca3af;
            --text-muted: #6b7280;
            --heading-color: #f9fafb;
            --border-color: #1f2937;
            --sidebar-bg: #0f172a;
            --table-border: #1f2937;
            --bg-main: #0b0f19;
            --primary-accent: #38bdf8;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            --table-hover: #1f2937;
            --badge-pending-bg: #451a03;
            --badge-pending-text: #fbbf24;
            --badge-approved-bg: #064e3b;
            --badge-approved-text: #34d399;
            --badge-rejected-bg: #7f1d1d;
            --badge-rejected-text: #f87171;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        @@keyframes slideInToast {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.9);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes fadeOutToast {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            to {
                opacity: 0;
                transform: translateY(15px) scale(0.9);
            }
        }

        .custom-toast {
            position: fixed;
            bottom: 35px;
            right: 35px;
            background-color: var(--card-bg);
            color: var(--heading-color);
            border: 2px solid var(--border-color);
            padding: 18px 26px;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 16px;
            z-index: 99999;
            font-size: 15px;
            font-weight: 600;
            animation: slideInToast 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

            .custom-toast.fade-out {
                animation: fadeOutToast 0.3s ease forwards;
            }

        .sidebar {
            width: 280px;
            min-width: 280px;
            height: 100vh;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px;
            position: sticky;
            top: 0;
            left: 0;
            overflow-y: auto;
        }

        .sidebar-top .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

            .sidebar-top .brand img {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                object-fit: cover;
            }

            .sidebar-top .brand h2 {
                font-size: 16px;
                font-weight: 700;
                color: var(--heading-color);
                letter-spacing: -0.3px;
            }

        /* Admin Team & Online Status Box in Sidebar */
        .sidebar-admin-section {
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 20px;
        }

        .admin-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            border-bottom: 1px dashed var(--border-color);
        }

            .admin-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .admin-avatar-box {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--primary-accent);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 12px;
            position: relative;
            flex-shrink: 0;
        }

        .online-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 2px solid var(--sidebar-bg);
            position: absolute;
            bottom: -1px;
            right: -1px;
        }

            .online-dot.active {
                background-color: #10b981; /* Green if online */
            }

            .online-dot.offline {
                background-color: #94a3b8; /* Gray if offline */
            }

        .nav-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .nav-links li a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 14px;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 500;
                font-size: 14px;
                border-radius: 6px;
                position: relative;
                cursor: pointer;
            }

                .nav-links li.active a, .nav-links li a:hover {
                    background-color: rgba(2, 132, 199, 0.08);
                    color: var(--primary-accent);
                }

            .nav-links li.active a {
                font-weight: 600;
            }

        .theme-toggle-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            color: var(--text-color);
            background-color: var(--bg-main);
            border: 1px solid var(--border-color);
            font-weight: 500;
            font-size: 14px;
            border-radius: 6px;
            cursor: pointer;
            margin-bottom: 10px;
            width: 100%;
            text-align: left;
        }

            .theme-toggle-btn:hover {
                border-color: var(--primary-accent);
            }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            color: #ef4444;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            border-radius: 6px;
            background-color: rgba(239, 68, 68, 0.06);
        }

            .logout-btn:hover {
                background-color: rgba(239, 68, 68, 0.12);
            }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow-y: auto;
        }

        .dashboard-header {
            background-color: var(--card-bg);
            padding: 18px 36px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .dashboard-header h1 {
                font-size: 20px;
                font-weight: 700;
                color: var(--heading-color);
                letter-spacing: -0.3px;
            }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid transparent;
        }

            .user-profile:hover {
                border-color: var(--border-color);
                background: var(--bg-main);
            }

        .dashboard-body {
            padding: 28px 36px;
            display: flex;
            flex-direction: column;
            gap: 24px;
            animation: fadeInSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes fadeInSlideUp {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .card, .metric-card {
            background-color: var(--card-bg);
            border-radius: 10px;
            padding: 22px;
            box-shadow: var(--card-shadow);
            border: 1px solid var(--border-color);
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .card:hover, .metric-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px -5px rgba(2, 132, 199, 0.1);
                border-color: rgba(2, 132, 199, 0.25);
            }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .metric-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .metric-card .metric-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 12px;
            }

            .metric-card h4 {
                font-size: 13px;
                font-weight: 600;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .metric-card .icon-box {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                background: rgba(2, 132, 199, 0.1);
                color: var(--primary-accent);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
            }

            .metric-card .value {
                font-size: 24px;
                font-weight: 700;
                color: var(--heading-color);
            }

        .lower-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
        }

        .card h3 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--heading-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }

            .table th, .table td {
                padding: 12px 10px;
                border-bottom: 1px solid var(--table-border);
                color: var(--text-color);
            }

            .table th {
                color: var(--text-muted);
                font-weight: 600;
                background-color: var(--bg-main);
            }

            .table tbody tr:hover {
                background-color: var(--table-hover);
            }

        .badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            display: inline-block;
        }

            .badge.pending {
                background-color: var(--badge-pending-bg);
                color: var(--badge-pending-text);
            }

            .badge.confirmed, .badge.approved, .badge.rescheduled {
                background-color: var(--badge-approved-bg);
                color: var(--badge-approved-text);
            }

            .badge.rejected, .badge.cancelled {
                background-color: var(--badge-rejected-bg);
                color: var(--badge-rejected-text);
            }

        .action-btn {
            background-color: var(--primary-accent);
            color: white;
            border: none;
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .action-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
                opacity: 0.95;
            }

        .btn-outline-warning {
            background: transparent;
            border: 1px solid #d97706;
            color: #d97706;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-outline-warning:hover {
                background: #d97706;
                color: white;
            }

        .btn-outline-danger {
            background: transparent;
            border: 1px solid #ef4444;
            color: #ef4444;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-outline-danger:hover {
                background: #ef4444;
                color: white;
            }

        .see-more-toggle {
            display: inline-block;
            margin-top: 12px;
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-accent);
            cursor: pointer;
            background: none;
            border: none;
            text-decoration: underline;
        }

            .see-more-toggle:hover {
                opacity: 0.8;
            }

        #chatToggleBtn {
            animation: floatBounce 3s infinite ease-in-out;
        }

        @@keyframes floatBounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        #chatToggleBtn:hover {
            transform: scale(1.08) !important;
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.35) !important;
        }

        .canva-modal-body {
            display: grid;
            grid-template-columns: 280px 1fr;
            height: 440px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
        }

        .canva-sidebar {
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
            text-align: left;
        }

        .canva-sidebar-section-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .canva-item-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
        }

        .canva-asset-card {
            aspect-ratio: 1;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            color: var(--text-color);
            transition: all 0.2s ease;
        }

            .canva-asset-card:hover, .canva-asset-card.active {
                border-color: var(--primary-accent);
                background: rgba(2, 132, 199, 0.08);
                color: var(--primary-accent);
            }

        .swatch-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .color-swatch {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: transform 0.15s ease;
        }

            .color-swatch:hover, .color-swatch.active {
                border-color: var(--heading-color);
                transform: scale(1.15);
            }

        .canva-canvas-viewport {
            background: var(--bg-main);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="brand">
                <img src="/images/logopet.jpeg" alt="Logo">
                <h2>PetCare Portal</h2>
            </div>

            <!-- ALL ADMIN PERSONNEL LIST & ONLINE STATUS WIDGET -->
            <div style="margin-bottom: 14px;">
                <span style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">
                    <i class="fa-solid fa-users-gear" style="color: var(--primary-accent); margin-right: 4px;"></i> Clinic Admin Team
                </span>
                <div class="sidebar-admin-section" id="sidebarAdminTeamContainer">
                    <!-- Dinamikong ika-load dito ang lahat ng Admins at ang kanilang Online status -->
                </div>
            </div>

            <ul class="nav-links">
                <li id="navDashboard" class="active"><a href="#" onclick="switchTab('dashboard'); return false;"><i class="fa-solid fa-chart-pie"></i> Dashboard</a></li>
                <li id="navAppointments"><a href="#" onclick="switchTab('appointments'); return false;"><i class="fa-solid fa-calendar-days"></i> Appointments</a></li>
                <li id="navMyPets"><a href="#" onclick="switchTab('mypets'); return false;"><i class="fa-solid fa-shield-dog"></i> My Pets</a></li>
                <li><a href="#" onclick="openProfileModal(); return false;"><i class="fa-solid fa-wand-magic-sparkles"></i> Pet Studio</a></li>
            </ul>
        </div>
        <div>
            <button class="theme-toggle-btn" onclick="toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i> <span id="themeText">Dark Mode</span>
            </button>
            <a href="/Account/Logout" class="logout-btn" onclick="handleLogout()"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out</a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="main-content">
        <header class="dashboard-header">
            <h1 id="headerMainTitle">Dashboard Overview</h1>
            <div style="display: flex; gap: 12px; align-items: center;">
                <button class="action-btn" id="headerBookBtn" style="display: none;" onclick="openAppointmentModal()"><i class="fa-solid fa-plus"></i> Book an Appointment</button>
                <div class="user-profile" onclick="openProfileModal()" title="Customize Profile">
                    <div style="text-align: right;">
                        <span style="display: block; font-weight: 600; font-size: 13px; color: var(--heading-color);" id="headerDisplayName">@ViewBag.ClientName</span>
                        <span style="font-size: 11px; color: var(--text-muted);">Client Portal</span>
                    </div>
                    <div id="headerAvatarContainer" style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; border: 1.5px solid var(--primary-accent); background: #ffffff; display: flex; align-items: center; justify-content: center;">
                        <svg id="headerPetSvg" viewBox="0 0 200 200" width="34" height="34">
                            <g id="headerSvgContent">
                                <ellipse cx="100" cy="120" rx="40" ry="32" fill="#0284c7" />
                                <circle cx="100" cy="85" r="28" fill="#0284c7" />
                                <ellipse cx="100" cy="94" rx="14" ry="11" fill="#fef3c7" />
                                <circle cx="91" cy="79" r="3.5" fill="#0f172a" />
                                <circle cx="109" cy="79" r="3.5" fill="#0f172a" />
                                <ellipse cx="100" cy="91" rx="4.5" ry="3" fill="#0f172a" />
                            </g>
                        </svg>
                    </div>
                </div>
            </div>
        </header>

        <div class="dashboard-body">
            <!-- TAB 1: DASHBOARD OVERVIEW -->
            <div id="tabDashboard" style="display: flex; flex-direction: column; gap: 24px;">
                <div class="metrics-grid">
                    <div class="metric-card">
                        <div class="metric-header">
                            <h4>Registered Pets</h4>
                            <div class="icon-box"><i class="fa-solid fa-paw"></i></div>
                        </div>
                        <div class="value" id="petCountDisplay">0</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-header">
                            <h4>Active Appointments</h4>
                            <div class="icon-box"><i class="fa-solid fa-calendar-check"></i></div>
                        </div>
                        <div class="value" id="activeAppointmentsCountDisplay">0</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-header">
                            <h4>Vaccination Status</h4>
                            <div class="icon-box"><i class="fa-solid fa-shield-heart"></i></div>
                        </div>
                        <div class="value" style="font-size: 16px; color: #047857; margin-top: 6px;">Verified Active</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-header">
                            <h4>Support Assistant</h4>
                            <div class="icon-box"><i class="fa-solid fa-robot"></i></div>
                        </div>
                        <div class="value" style="font-size: 16px; color: var(--primary-accent); margin-top: 6px;">Online 24/7</div>
                    </div>
                </div>

                <div class="lower-grid">
                    <div style="display: flex; flex-direction: column; gap: 24px;">
                        <div class="card" id="appointmentsCardSection">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                <h3><i class="fa-solid fa-calendar-days" style="color: var(--primary-accent);"></i> Scheduled Appointments</h3>
                                <button class="action-btn" onclick="openAppointmentModal()"><i class="fa-solid fa-plus"></i> New Booking</button>
                            </div>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Pet Record</th>
                                        <th>Service Type</th>
                                        <th>Schedule Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="combinedAppointmentsTableBody"></tbody>
                            </table>
                            <div id="dashboardSeeMoreContainer" style="text-align: center; margin-top: 10px;"></div>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 24px;">
                        <!-- STANDALONE / NORMAL REFERENCE CALENDAR WIDGET WITH MOVING BLUE CIRCLE -->
                        <div class="card">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                                <h3 style="margin: 0; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                                    <i class="fa-solid fa-calendar-days" style="color: var(--primary-accent);"></i> Schedule Reference
                                </h3>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <button onclick="changeMonth(-1)" style="background: none; border: 1px solid var(--border-color); border-radius: 4px; padding: 2px 7px; cursor: pointer; color: var(--text-color); font-size: 11px;"><i class="fa-solid fa-chevron-left"></i></button>
                                    <span id="calendarMonthLabel" style="font-size: 12px; font-weight: 600; color: var(--heading-color); min-width: 95px; text-align: center;">November 2026</span>
                                    <button onclick="changeMonth(1)" style="background: none; border: 1px solid var(--border-color); border-radius: 4px; padding: 2px 7px; cursor: pointer; color: var(--text-color); font-size: 11px;"><i class="fa-solid fa-chevron-right"></i></button>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; gap: 4px;">
