@{
    ViewData["Title"] = "Client Dashboard - PetCare Service Site";
    Layout = null;

    // Retrieve shared appointments list passed from Controller
    var clientAppointments = ViewBag.Appointments as List<MyPetcare.Models.AppointmentModel> ?? new List<MyPetcare.Models.AppointmentModel>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Theme Variables - Deep Obsidian Cyber Dark Theme Support */
        :root {
            --bg-color: #f4f7f6;
            --card-bg: #ffffff;
            --text-color: #333333;
            --text-muted: #64748b;
            --heading-color: #0f172a;
            --border-color: #e2e8f0;
            --sidebar-bg: #ffffff;
            --table-border: #f1f5f9;
            --bg-main: #f8fafc;
            --primary-accent: #0284c7;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --table-hover: #f8fafc;
            --badge-pending-bg: #fef3c7;
            --badge-pending-text: #d97706;
            --badge-approved-bg: #d1fae5;
            --badge-approved-text: #059669;
            --badge-rejected-bg: #fee2e2;
            --badge-rejected-text: #dc2626;
        }

        [data-theme="dark"] {
            --bg-color: #090d16;
            --card-bg: #131b2e;
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --heading-color: #ffffff;
            --border-color: #1e293b;
            --sidebar-bg: #060911;
            --table-border: #1e293b;
            --bg-main: #090d16;
            --primary-accent: #38bdf8;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --table-hover: #1e293b;
            --badge-pending-bg: #451a03;
            --badge-pending-text: #fbbf24;
            --badge-approved-bg: #064e3b;
            --badge-approved-text: #34d399;
            --badge-rejected-bg: #7f1d1d;
            --badge-rejected-text: #f87171;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
            transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Sidebar Navigation with Indicator */
        .sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px;
        }

        .sidebar-top .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 30px;
        }

            .sidebar-top .brand img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: contain;
            }

            .sidebar-top .brand h2 {
                font-size: 18px;
                font-weight: 700;
                color: var(--heading-color);
            }

        .nav-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .nav-links li a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 600;
                border-radius: 8px;
                position: relative;
                transition: all 0.25s ease;
            }

                .nav-links li.active a, .nav-links li a:hover {
                    background-color: rgba(2, 132, 199, 0.15);
                    color: var(--primary-accent);
                }

                    .nav-links li.active a::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 15%;
                        height: 70%;
                        width: 4px;
                        background: var(--primary-accent);
                        border-radius: 0 4px 4px 0;
                        box-shadow: 0 0 8px var(--primary-accent);
                    }

        /* Theme Toggle & Logout Buttons */
        .theme-toggle-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--text-color);
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            text-decoration: none;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 12px;
            width: 100%;
            text-align: left;
        }

            .theme-toggle-btn:hover {
                border-color: var(--primary-accent);
            }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: #dc2626;
            text-decoration: none;
            font-weight: 600;
            border-radius: 8px;
            background-color: var(--badge-rejected-bg);
            transition: background 0.2s;
        }

            .logout-btn:hover {
                opacity: 0.9;
            }

        /* Main Content Area */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* Top Header */
        .dashboard-header {
            background-color: var(--card-bg);
            padding: 20px 40px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .dashboard-header h1 {
                font-size: 22px;
                color: var(--heading-color);
            }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 20px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }

            .user-profile:hover {
                border-color: var(--border-color);
                background: var(--bg-main);
            }

        /* Dashboard Body Grid with Smooth Entrance Animation */
        .dashboard-body {
            padding: 30px 40px;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            animation: fadeInSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes fadeInSlideUp {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Enhanced Glassmorphism Card Hover Lift */
        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(12px);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 24px -6px rgba(2, 132, 199, 0.15);
                border-color: rgba(2, 132, 199, 0.3);
            }

            .card h3 {
                font-size: 18px;
                margin-bottom: 16px;
                color: var(--heading-color);
                display: flex;
                align-items: center;
                gap: 8px;
            }

        /* Tables & Lists */
        .table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 14px;
        }

            .table th, .table td {
                padding: 14px 12px;
                border-bottom: 1px solid var(--table-border);
                color: var(--text-color);
            }

            .table th {
                color: var(--text-muted);
                font-weight: 600;
            }

            .table tbody tr:hover {
                background-color: var(--table-hover);
            }

        /* Animated Glowing Status Badges */
        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: capitalize;
            display: inline-block;
        }

            .badge.pending {
                background-color: var(--badge-pending-bg);
                color: var(--badge-pending-text);
                box-shadow: 0 0 8px rgba(251, 191, 36, 0.25);
                animation: pulse-glow 2s infinite ease-in-out;
            }

        @@keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 4px rgba(251, 191, 36, 0.2);
            }

            50% {
                box-shadow: 0 0 12px rgba(251, 191, 36, 0.5);
            }
        }

        .badge.confirmed, .badge.approved {
            background-color: var(--badge-approved-bg);
            color: var(--badge-approved-text);
        }

        .badge.rejected, .badge.cancelled {
            background-color: var(--badge-rejected-bg);
            color: var(--badge-rejected-text);
        }

        /* Micro-Interaction Buttons */
        .action-btn {
            background-color: var(--primary-accent);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .action-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
                opacity: 0.95;
            }

            .action-btn:active {
                transform: translateY(0) scale(0.96);
            }

        /* Floating Chatbot Bounce Effect */
        #chatToggleBtn {
            animation: floatBounce 3s infinite ease-in-out;
        }

        @@keyframes floatBounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        #chatToggleBtn:hover {
            transform: scale(1.1) !important;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.5) !important;
        }

        /* CANVA-STYLE CHARACTER CREATOR MODAL LAYOUT */
        .canva-modal-body {
            display: grid;
            grid-template-columns: 280px 1fr;
            height: 440px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
        }

        .canva-sidebar {
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            overflow-y: auto;
            text-align: left;
        }

        .canva-sidebar-section-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .canva-item-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .canva-asset-card {
            aspect-ratio: 1;
            background: var(--bg-main);
            border: 2px solid var(--border-color);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            padding: 6px;
            font-size: 12px;
        }

            .canva-asset-card:hover, .canva-asset-card.active {
                border-color: var(--primary-accent);
                background: rgba(2, 132, 199, 0.1);
            }

        .swatch-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .color-swatch {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: transform 0.15s ease;
        }

            .color-swatch:hover, .color-swatch.active {
                transform: scale(1.15);
                border-color: var(--heading-color);
            }

        .canva-canvas-viewport {
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="brand">
                <img src="/images/logopet.jpeg" alt="Logo">
                <h2>PetCare Portal</h2>
            </div>
            <ul class="nav-links">
                <li class="active"><a href="@Url.Action("ClientDashboard", "Home")"><i class="fa-solid fa-house"></i> Dashboard</a></li>
                <li><a href="#" onclick="openProfileModal(); return false;"><i class="fa-solid fa-wand-magic-sparkles"></i> Pet Character Studio</a></li>
                <li><a href="#" onclick="openFriendsModal(); return false;"><i class="fa-solid fa-user-group"></i> Friends & Visit</a></li>
                <li><a href="#"><i class="fa-solid fa-calendar-check"></i> Appointments</a></li>
                <li><a href="#"><i class="fa-solid fa-paw"></i> My Pets</a></li>
            </ul>
        </div>
        <div>
            <!-- Theme Toggle Button -->
            <button class="theme-toggle-btn" onclick="toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i> <span id="themeText">Dark Mode</span>
            </button>
            <a href="/Account/Logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Log out</a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="dashboard-header">
            <h1>Welcome back, @ViewBag.ClientName! 🐾</h1>
            <div class="user-profile" onclick="openProfileModal()" title="Click to customize pet profile avatar">
                <div style="text-align: right;">
                    <span style="display: block; font-weight: 700; font-size: 14px;" id="headerDisplayName">@ViewBag.ClientName</span>
                    <span style="font-size: 12px; color: var(--text-muted);">Client Account</span>
                </div>
                <!-- Dynamic Header Avatar SVG Container -->
                <div id="headerAvatarContainer" style="width: 42px; height: 42px; border-radius: 50%; overflow: hidden; border: 2px solid var(--primary-accent); background: #ffffff; display: flex; align-items: center; justify-content: center;">
                    <svg id="headerPetSvg" viewBox="0 0 200 200" width="38" height="38">
                        <ellipse cx="100" cy="120" rx="40" ry="32" fill="#d97706" />
                        <circle cx="100" cy="85" r="28" fill="#d97706" />
                        <ellipse cx="100" cy="94" rx="14" ry="11" fill="#fef3c7" />
                        <circle cx="91" cy="79" r="3.5" fill="#0f172a" />
                        <circle cx="109" cy="79" r="3.5" fill="#0f172a" />
                        <ellipse cx="100" cy="91" rx="4.5" ry="3" fill="#0f172a" />
                    </svg>
                </div>
            </div>
        </header>

        <div class="dashboard-body">
            <!-- Left Column: Appointments & Quick Actions -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <div class="card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h3><i class="fa-solid fa-calendar-days" style="color: var(--primary-accent);"></i> My Appointments</h3>
                        <button class="action-btn" onclick="openAppointmentModal()">+ New Appointment</button>
                    </div>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Pet Name</th>
                                <th>Service</th>
                                <th>Date & Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (clientAppointments.Any())
                            {
                                foreach (var item in clientAppointments)
                                {
                                    <tr>
                                        <td><strong>@item.PetName</strong></td>
                                        <td>@item.Service</td>
                                        <td>@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                        <td>
                                            <span class="badge @item.Status.ToLower()">@item.Status</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center; color: var(--text-muted);">No appointments booked yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card">
                    <h3><i class="fa-solid fa-paw" style="color: var(--primary-accent);"></i> Registered Pets Information</h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 15px;">
                        <div style="background: var(--bg-main); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <h4 style="color: var(--heading-color); margin-bottom: 4px;">Max 🐕</h4>
                            <p style="font-size: 13px; color: var(--text-muted);">Breed: Corgi</p>
                            <p style="font-size: 13px; color: var(--text-muted);">Age: 2 Years Old</p>
                        </div>
                        <div style="background: var(--bg-main); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <h4 style="color: var(--heading-color); margin-bottom: 4px;">Luna 🐈</h4>
                            <p style="font-size: 13px; color: var(--text-muted);">Breed: Puspin / Domestic</p>
                            <p style="font-size: 13px; color: #16a34a; font-weight: 600;">Vaccinated ✓</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: PetBot Quick Help Widget Preview -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <div class="card" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: white; border: none;">
                    <h3 style="color: white;"><i class="fa-solid fa-robot"></i> PetBot AI Support</h3>
                    <p style="font-size: 14px; opacity: 0.9; line-height: 1.5; margin-bottom: 16px;">
                        Need quick advice about your pet's diet, symptoms, or vaccine schedules? PetBot is online 24/7 at the bottom right corner!
                    </p>
                    <div style="background: rgba(255,255,255,0.15); padding: 12px; border-radius: 8px; font-size: 13px;">
                        💡 <strong>Tip:</strong> Try asking PetBot about foods that are toxic to dogs or clinic schedules.
                    </div>
                </div>

                <div class="card">
                    <h3><i class="fa-solid fa-circle-info" style="color: var(--primary-accent);"></i> Clinic Announcements</h3>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14px; color: var(--text-muted);">
                        <li style="border-bottom: 1px solid var(--table-border); padding-bottom: 8px;">
                            🏥 <strong style="color: var(--heading-color);">Free Anti-Rabies Drive:</strong> This coming Saturday at the Alaminos City Veterinary Office.
                        </li>
                        <li>
                            ⏰ <strong style="color: var(--heading-color);">Holiday Schedule:</strong> We are open during regular hours this coming holiday.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </main>

    <!-- CANVA-STYLE MULTI-ANIMAL CHARACTER CREATOR MODAL -->
    <div id="profileModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 30000; justify-content: center; align-items: center; backdrop-filter: blur(8px);">
        <div class="card" style="width: 760px; max-width: 95%; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.4); padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <h3 style="margin: 0; font-size: 18px;"><i class="fa-solid fa-wand-magic-sparkles" style="color: var(--primary-accent);"></i> Pet Character Studio 🐾</h3>
                <button onclick="closeProfileModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-muted);">&times;</button>
            </div>

            <!-- Canva Builder Body -->
            <div class="canva-modal-body">
                <!-- Left Sidebar Picker -->
                <div class="canva-sidebar">
                    <!-- Animal Species Selector -->
                    <span class="canva-sidebar-section-title">Select Species</span>
                    <div class="canva-item-grid">
                        <div class="canva-asset-card active" onclick="setSpecies('dog')">🐶 Dog</div>
                        <div class="canva-asset-card" onclick="setSpecies('cat')">🐱 Cat</div>
                        <div class="canva-asset-card" onclick="setSpecies('rabbit')">🐰 Rabbit</div>
                        <div class="canva-asset-card" onclick="setSpecies('bird')">🦜 Bird</div>
                    </div>

                    <!-- Fur Color Section -->
                    <span class="canva-sidebar-section-title">Color / Fur Tone</span>
                    <div class="swatch-group">
                        <div class="color-swatch active" style="background: #d97706;" onclick="setFurColor('#d97706')"></div>
                        <div class="color-swatch" style="background: #64748b;" onclick="setFurColor('#64748b')"></div>
                        <div class="color-swatch" style="background: #451a03;" onclick="setFurColor('#451a03')"></div>
                        <div class="color-swatch" style="background: #f8fafc;" onclick="setFurColor('#f8fafc')"></div>
                        <div class="color-swatch" style="background: #fbbf24;" onclick="setFurColor('#fbbf24')"></div>
                    </div>

                    <!-- Ears / Features Section -->
                    <span class="canva-sidebar-section-title">Ears & Features</span>
                    <div class="canva-item-grid">
                        <div class="canva-asset-card active" onclick="setEars('default')">✨ Default</div>
                        <div class="canva-asset-card" onclick="setEars('floppy')">👂 Floppy</div>
                        <div class="canva-asset-card" onclick="setEars('pointed')">🔺 Pointed</div>
                    </div>

                    <!-- Expressions Section -->
                    <span class="canva-sidebar-section-title">Face Expression</span>
                    <div class="canva-item-grid">
                        <div class="canva-asset-card active" onclick="setExpression('happy')">😊 Happy</div>
                        <div class="canva-asset-card" onclick="setExpression('wink')">😉 Wink</div>
                        <div class="canva-asset-card" onclick="setExpression('cool')">😎 Cool</div>
                    </div>

                    <!-- Outfits Section -->
                    <span class="canva-sidebar-section-title">Outfits</span>
                    <div class="canva-item-grid">
                        <div class="canva-asset-card" onclick="setOutfit('none')">🚫 None</div>
                        <div class="canva-asset-card active" onclick="setOutfit('tee')">👕 Shirt</div>
                        <div class="canva-asset-card" onclick="setOutfit('dress')">👗 Dress</div>
                    </div>
                    <div class="swatch-group">
                        <div class="color-swatch" style="background: #ef4444;" onclick="setOutfitColor('#ef4444')"></div>
                        <div class="color-swatch" style="background: #2563eb;" onclick="setOutfitColor('#2563eb')"></div>
                        <div class="color-swatch" style="background: #10b981;" onclick="setOutfitColor('#10b981')"></div>
                        <div class="color-swatch" style="background: #8b5cf6;" onclick="setOutfitColor('#8b5cf6')"></div>
                    </div>

                    <!-- Headwear Section -->
                    <span class="canva-sidebar-section-title">Headwear</span>
                    <div class="canva-item-grid">
                        <div class="canva-asset-card active" onclick="setCap('cap')">🧢 Cap</div>
                        <div class="canva-asset-card" onclick="setCap('bow')">🎀 Bow</div>
                        <div class="canva-asset-card" onclick="setCap('none')">🚫 None</div>
                    </div>
                </div>

                <!-- Right Canva Viewport -->
                <div class="canva-canvas-viewport">
                    <svg id="canvaPetSvg" viewBox="0 0 200 200" width="240" height="240">
                        <!-- Dynamic Tail Layer -->
                        <g id="svgTailLayer">
                            <path id="svgTail" d="M 50 110 Q 30 95 40 80" stroke="#d97706" stroke-width="8" stroke-linecap="round" fill="none" />
                        </g>
                        <!-- Body Layer -->
