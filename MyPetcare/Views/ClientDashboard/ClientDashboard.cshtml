            </div>
            <div style="padding: 10px; border-top: 1px solid var(--border-color); display: flex; gap: 6px; background-color: var(--card-bg);">
                <input type="text" id="chatInput" placeholder="Type a message..." onkeypress="handleChatKeyPress(event)" style="flex: 1; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-color); background-color: var(--bg-main); color: var(--text-color); font-size: 13px; outline: none;" />
                <button onclick="sendChatMessage()" style="background-color: var(--primary-accent); color: white; border: none; padding: 0 14px; border-radius: 6px; cursor: pointer; font-size: 13px;">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        let currentSpecies = "dog";
        let currentFurColor = "#0284c7";
        let currentEars = "default";
        let currentExpression = "happy";
        let currentOutfit = "tee";

        const userIdentifier = "@ViewBag.ClientName" ? "@ViewBag.ClientName".replace(/\s+/g, '_').toLowerCase() : "default_client";
        let currentCalendarDate = new Date();
        let selectedCalendarDate = null;

        document.addEventListener("DOMContentLoaded", () => {
            const serverClientName = "@ViewBag.ClientName";
            if (serverClientName) {
                document.getElementById('headerDisplayName').innerText = serverClientName;
            }

            const savedHeaderSvg = localStorage.getItem('header_pet_svg_' + userIdentifier);
            if (savedHeaderSvg) {
                document.getElementById('headerSvgContent').innerHTML = savedHeaderSvg;
            }

            renderStudioPet();
            loadSavedPets();
            loadClientAnnouncements();
            loadAppointmentsPageView();
            renderClientCalendar();
            loadAdminTeamSidebar(); // Load all admins and online status

            // Auto-refresh admin status every 5 seconds para real-time ang green/gray dot
            setInterval(loadAdminTeamSidebar, 5000);

            // Automatic Click Sound Effect Global Listener para sa lahat ng Buttons, Links, at Tabs
            document.addEventListener('click', (e) => {
                const target = e.target.closest('button, a, .canva-asset-card, .color-swatch');
                if (target) {
                    playClickSound();
                }
            });
        });

        // Load all Admins and check if they are currently Online
        function loadAdminTeamSidebar() {
            const container = document.getElementById('sidebarAdminTeamContainer');
            if (!container) return;

            // Kunin ang listahan ng lahat ng admins (maaaring i-save ng Admin dashboard sa localStorage, o maglagay ng default kung nag-iisa pa lang)
            let adminsList = JSON.parse(localStorage.getItem('admin_team_directory') || '[]');

            // Kung walang naka-save na directory, idagdag ang kasalukuyang admin profile bilang default
            let currentAdmin = JSON.parse(localStorage.getItem('admin_profile_data') || '{"name": "System Administrator", "position": "Administrator Role"}');

            if (adminsList.length === 0) {
                adminsList = [{ id: 'admin_1', name: currentAdmin.name, position: currentAdmin.position }];
            }

            // Kunin ang online heartbeats ng mga admin (sine-save ng admin dashboard habang aktibo sila)
            let onlineHeartbeats = JSON.parse(localStorage.getItem('admin_online_heartbeats') || '{}');
            let now = new Date().getTime();

            let html = '';
            adminsList.forEach(adm => {
                let initials = adm.name ? adm.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'AD';

                // Active/Online kung nag-ping o nag-update sa loob ng huling 30 segundo (30000ms)
                let lastActiveTime = onlineHeartbeats[adm.id || adm.name] || 0;
                let isOnline = (now - lastActiveTime) < 30000;

                // Kung ang kasalukuyang client ay naka-open din o nagpasa ng active signal, o kung active session:
                let dotClass = isOnline ? 'active' : 'offline';
                let statusText = isOnline ? 'Online' : 'Offline';

                html += `
                    <div class="admin-item">
                        <div class="admin-avatar-box">
                            ${initials}
                            <div class="online-dot ${dotClass}" title="${statusText}"></div>
                        </div>
                        <div style="overflow: hidden; flex: 1;">
                            <span style="font-size: 12px; font-weight: 600; color: var(--heading-color); display: block; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">${adm.name}</span>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 10px; color: var(--text-muted); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">${adm.position}</span>
                                <span style="font-size: 9px; font-weight: 600; color: ${isOnline ? '#10b981' : '#94a3b8'};">${statusText}</span>
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // Click / Pop Sound Effect gamit ang Web Audio API
        function playClickSound() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.08);

                gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);

                osc.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                osc.start();
                osc.stop(audioCtx.currentTime + 0.08);
            } catch (e) {
                console.log("Audio not supported", e);
            }
        }

        // Success / Notification Chime Sound Effect
        function playSuccessSound() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // Note D5
                osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.15); // Note A5

                gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);

                osc.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } catch (e) {
                console.log("Audio not supported", e);
            }
        }

        // Malaki, Malinaw at May Sound Effect na Custom Toast Notification
        function showCustomToast(message, type = 'success') {
            const existingToast = document.getElementById('activeCustomToast');
            if (existingToast) existingToast.remove();

            playSuccessSound();

            const toast = document.createElement('div');
            toast.id = 'activeCustomToast';
            toast.className = 'custom-toast';

            let iconColor = type === 'error' ? '#ef4444' : 'var(--primary-accent)';
            let iconClass = type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check';

            toast.innerHTML = `
                <i class="fa-solid ${iconClass}" style="color: ${iconColor}; font-size: 22px;"></i>
                <span style="font-size: 15px; letter-spacing: -0.2px;">${message}</span>
            `;

            document.body.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function changeMonth(direction) {
            currentCalendarDate.setMonth(currentCalendarDate.getMonth() + direction);
            renderClientCalendar();
        }

        function renderClientCalendar() {
            const container = document.getElementById('calendarDaysContainer');
            const label = document.getElementById('calendarMonthLabel');
            if (!container) return;

            const year = currentCalendarDate.getFullYear();
            const month = currentCalendarDate.getMonth();

            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            label.innerText = `${monthNames[month]} ${year}`;

            const firstDayIndex = new Date(year, month, 1).getDay();
            const totalDays = new Date(year, month + 1, 0).getDate();

            let html = '';
            for (let i = 0; i < firstDayIndex; i++) {
                html += `<div></div>`;
            }

            const todayReal = new Date();

            for (let day = 1; day <= totalDays; day++) {
                let isToday = (day === todayReal.getDate() && month === todayReal.getMonth() && year === todayReal.getFullYear());
                let isSelected = (selectedCalendarDate && day === selectedCalendarDate.getDate() && month === selectedCalendarDate.getMonth() && year === selectedCalendarDate.getFullYear());

                let style = `
                    padding: 6px 0;
                    font-size: 12px;
                    font-weight: 500;
                    border-radius: 50%;
                    width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin: 2px auto;
                    color: var(--text-color);
                    cursor: pointer;
                    transition: all 0.2s ease;
                `;

                if (isSelected || (isToday && !selectedCalendarDate)) {
                    style += `background-color: var(--primary-accent); color: white; font-weight: 700; box-shadow: 0 2px 6px rgba(2, 132, 199, 0.4);`;
                }

                html += `<div style="${style}" onmouseover="if(!this.style.backgroundColor) this.style.background='rgba(2, 132, 199, 0.15)'" onmouseout="if(!this.style.backgroundColor.includes('rgb(2, 132, 199)')) this.style.background='transparent'" onclick="selectStandaloneDate(${day}, ${month}, ${year})">${day}</div>`;
            }

            container.innerHTML = html;
        }

        function selectStandaloneDate(day, month, year) {
            selectedCalendarDate = new Date(year, month, day);
            renderClientCalendar();

            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            const displayElem = document.getElementById('selectedDateDisplay');
            if (displayElem) {
                displayElem.innerHTML = `<i class="fa-solid fa-calendar-day" style="color: var(--primary-accent); margin-right: 4px;"></i> Selected: <strong>${monthNames[month]} ${day}, ${year}</strong>`;
            }
        }

        let dashboardShowAll = false;
        let appointmentsTabShowAll = {};

        function switchTab(tabName) {
            const tabDashboard = document.getElementById('tabDashboard');
            const tabAppointments = document.getElementById('tabAppointments');
            const tabMyPets = document.getElementById('tabMyPets');
            const navDashboard = document.getElementById('navDashboard');
            const navAppointments = document.getElementById('navAppointments');
            const navMyPets = document.getElementById('navMyPets');
            const headerTitle = document.getElementById('headerMainTitle');
            const headerBookBtn = document.getElementById('headerBookBtn');

            tabDashboard.style.display = 'none';
            tabAppointments.style.display = 'none';
            tabMyPets.style.display = 'none';
            navDashboard.className = '';
            navAppointments.className = '';
            navMyPets.className = '';

            if (tabName === 'dashboard') {
                tabDashboard.style.display = 'flex';
                navDashboard.className = 'active';
                headerTitle.innerText = 'Dashboard Overview';
                headerBookBtn.style.display = 'none';
                loadSavedPets();
            } else if (tabName === 'appointments') {
                tabAppointments.style.display = 'flex';
                navAppointments.className = 'active';
                headerTitle.innerText = 'Appointment Records';
                headerBookBtn.style.display = 'inline-flex';
                loadAppointmentsPageView();
            } else if (tabName === 'mypets') {
                tabMyPets.style.display = 'flex';
                navMyPets.className = 'active';
                headerTitle.innerText = 'My Pets Directory';
                headerBookBtn.style.display = 'inline-flex';
                loadSavedPets();
            }
        }

        function renderStudioPet() {
            document.getElementById('svgBody').setAttribute('fill', currentFurColor);
            document.getElementById('svgHead').setAttribute('fill', currentFurColor);

            const darkerColor = adjustColor(currentFurColor, -30);
            document.getElementById('svgLegLeft').setAttribute('fill', darkerColor);
            document.getElementById('svgLegRight').setAttribute('fill', darkerColor);

            const earsLayer = document.getElementById('svgEarsLayer');
            const tailLayer = document.getElementById('svgTailLayer');

            if (currentSpecies === 'cat') {
                earsLayer.innerHTML = `<path d="M 75 68 L 58 35 L 85 58 Z" fill="${darkerColor}" /><path d="M 125 68 L 142 35 L 115 58 Z" fill="${darkerColor}" />`;
                tailLayer.innerHTML = `<path d="M 50 120 Q 20 140 25 100 Q 30 80 20 70" stroke="${currentFurColor}" stroke-width="6" stroke-linecap="round" fill="none" />`;
            } else if (currentSpecies === 'rabbit') {
                earsLayer.innerHTML = `<ellipse cx="78" cy="40" rx="8" ry="32" fill="${currentFurColor}" /><ellipse cx="122" cy="40" rx="8" ry="32" fill="${currentFurColor}" />`;
                tailLayer.innerHTML = `<circle cx="45" cy="125" r="10" fill="#ffffff" />`;
            } else if (currentSpecies === 'bird') {
                earsLayer.innerHTML = `<path d="M 90 60 L 100 40 L 110 60 Z" fill="${darkerColor}" />`;
                tailLayer.innerHTML = `<path d="M 55 125 L 35 135 L 45 115 Z" fill="${darkerColor}" />`;
            } else {
                if (currentEars === 'floppy') {
                    earsLayer.innerHTML = `<path d="M 72 72 Q 45 70 60 100 Z" fill="${darkerColor}" /><path d="M 128 72 Q 155 70 140 100 Z" fill="${darkerColor}" />`;
                } else if (currentEars === 'pointed') {
                    earsLayer.innerHTML = `<path d="M 75 70 L 60 40 L 88 62 Z" fill="${darkerColor}" /><path d="M 125 70 L 140 40 L 112 62 Z" fill="${darkerColor}" />`;
                } else {
                    earsLayer.innerHTML = `<path d="M 75 75 Q 55 60 65 85 Z" fill="${darkerColor}" /><path d="M 125 75 Q 145 60 135 85 Z" fill="${darkerColor}" />`;
                }
                tailLayer.innerHTML = `<path d="M 50 110 Q 30 95 40 80" stroke="${currentFurColor}" stroke-width="8" stroke-linecap="round" fill="none" />`;
            }

            const eyesGroup = document.getElementById('svgEyes');
            const glassesGroup = document.getElementById('svgGlassesGroup');
            glassesGroup.innerHTML = '';

            if (currentExpression === 'wink') {
                eyesGroup.innerHTML = `<path d="M 87 79 Q 91 74 95 79" stroke="#0f172a" stroke-width="2.5" fill="none" stroke-linecap="round" /><circle cx="109" cy="79" r="3.5" fill="#0f172a" />`;
            } else if (currentExpression === 'cool') {
                eyesGroup.innerHTML = `<circle cx="91" cy="79" r="3.5" fill="#0f172a" /><circle cx="109" cy="79" r="3.5" fill="#0f172a" />`;
                glassesGroup.innerHTML = `<rect x="80" y="72" width="18" height="12" rx="3" fill="#0f172a" /><rect x="102" y="72" width="18" height="12" rx="3" fill="#0f172a" /><line x1="98" y1="78" x2="102" y2="78" stroke="#0f172a" stroke-width="2" />`;
            } else {
                eyesGroup.innerHTML = `<circle cx="91" cy="79" r="3.5" fill="#0f172a" /><circle cx="109" cy="79" r="3.5" fill="#0f172a" />`;
            }

            const outfitGroup = document.getElementById('svgOutfitGroup');
            if (currentOutfit === 'dress') {
                outfitGroup.innerHTML = `<path d="M 68 102 Q 100 92 132 102 L 148 142 Q 100 148 52 142 Z" fill="#ec4899" />`;
            } else if (currentOutfit === 'tee') {
                outfitGroup.innerHTML = `<path d="M 68 100 Q 100 90 132 100 L 140 135 Q 100 142 60 135 Z" fill="#ef4444" />`;
            } else {
                outfitGroup.innerHTML = '';
            }
        }

        function setSpecies(species) {
            currentSpecies = species;
            ['btnSpeciesDog', 'btnSpeciesCat', 'btnSpeciesRabbit', 'btnSpeciesBird'].forEach(id => {
                document.getElementById(id)?.classList.remove('active');
            });
            if (species === 'cat') document.getElementById('btnSpeciesCat')?.classList.add('active');
            else if (species === 'rabbit') document.getElementById('btnSpeciesRabbit')?.classList.add('active');
            else if (species === 'bird') document.getElementById('btnSpeciesBird')?.classList.add('active');
            else document.getElementById('btnSpeciesDog')?.classList.add('active');
            renderStudioPet();
        }

        function setFurColor(hex, elem) {
            currentFurColor = hex;
            if (elem) {
                document.querySelectorAll('.swatch-group .color-swatch').forEach(s => s.classList.remove('active'));
                elem.classList.add('active');
            }
            renderStudioPet();
        }

        function setEars(style) {
            currentEars = style;
            ['btnEarsDefault', 'btnEarsFloppy', 'btnEarsPointed'].forEach(id => {
                document.getElementById(id)?.classList.remove('active');
            });
            if (style === 'floppy') document.getElementById('btnEarsFloppy')?.classList.add('active');
            else if (style === 'pointed') document.getElementById('btnEarsPointed')?.classList.add('active');
            else document.getElementById('btnEarsDefault')?.classList.add('active');
            renderStudioPet();
        }

        function setExpression(exp) {
            currentExpression = exp;
            ['btnExpHappy', 'btnExpWink', 'btnExpCool'].forEach(id => {
                document.getElementById(id)?.classList.remove('active');
            });
            if (exp === 'wink') document.getElementById('btnExpWink')?.classList.add('active');
            else if (exp === 'cool') document.getElementById('btnExpCool')?.classList.add('active');
            else document.getElementById('btnExpHappy')?.classList.add('active');
            renderStudioPet();
        }

        function setOutfit(style) {
            currentOutfit = style;
            ['btnOutfitNone', 'btnOutfitTee', 'btnOutfitDress'].forEach(id => {
                document.getElementById(id)?.classList.remove('active');
            });
            if (style === 'dress') document.getElementById('btnOutfitDress')?.classList.add('active');
            else if (style === 'tee') document.getElementById('btnOutfitTee')?.classList.add('active');
            else document.getElementById('btnOutfitNone')?.classList.add('active');
            renderStudioPet();
        }

        function saveProfileChanges() {
            const newName = document.getElementById('modalDisplayName').value.trim();
            if (newName) {
                document.getElementById('headerDisplayName').innerText = newName;
            }
            const studioSvgInner = document.getElementById('canvaPetSvg').innerHTML;
            document.getElementById('headerSvgContent').innerHTML = studioSvgInner;

            localStorage.setItem('header_pet_svg_' + userIdentifier, studioSvgInner);
            localStorage.setItem('pet_studio_config_' + userIdentifier, JSON.stringify({
                species: currentSpecies, furColor: currentFurColor, ears: currentEars, expression: currentExpression, outfit: currentOutfit, name: newName
            }));

            closeProfileModal();
            showCustomToast("Pet avatar updated successfully! You can edit anytime.");
        }

        function adjustColor(hex, amt) {
            let usePound = false;
            if (hex[0] == "#") { hex = hex.slice(1); usePound = true; }
            let num = parseInt(hex, 16);
            let r = (num >> 16) + amt;
            if (r > 255) r = 255; else if (r < 0) r = 0;
            let b = ((num >> 8) & 0x00FF) + amt;
            if (b > 255) b = 255; else if (b < 0) b = 0;
            let g = (num & 0x0000FF) + amt;
            if (g > 255) g = 255; else if (g < 0) g = 0;
            return (usePound ? "#" : "") + (g | (b << 8) | (r << 16)).toString(16).padStart(6, '0');
        }

        function toggleDashboardSeeMore() {
            dashboardShowAll = !dashboardShowAll;
            loadSavedPets();
        }

        function togglePetGroupSeeMore(petKey) {
            appointmentsTabShowAll[petKey] = !appointmentsTabShowAll[petKey];
            loadAppointmentsPageView();
        }

        function loadAppointmentsPageView() {
            let dbAppointments = [];
            @if (clientAppointments.Any())
            {
                        foreach (var item in clientAppointments)
                        {
                                    @:dbAppointments.push({ petName: '@item.PetName', service: '@item.Service', date: '@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")', status: '@item.Status', id: '@item.Id' });
                        }
            }

            let statusOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides_' + userIdentifier) || '{}');
            let allRecords = dbAppointments.map(rec => {
                if (rec.id && statusOverrides[rec.id]) {
                    rec.status = statusOverrides[rec.id].status;
                    if (statusOverrides[rec.id].date) {
                        rec.date = statusOverrides[rec.id].date;
                    }
                }
                return rec;
            });

            document.getElementById('metricTotalAppointments').innerText = allRecords.length;

            let grouped = {};
            allRecords.forEach(item => {
                let key = item.petName || 'Unknown Pet';
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(item);
            });

            document.getElementById('metricPetsWithRecords').innerText = Object.keys(grouped).length;

            let container = document.getElementById('groupedAppointmentsContainer');
            container.innerHTML = '';

            if (Object.keys(grouped).length === 0) {
                container.innerHTML = `<div class="card" style="text-align: center; color: var(--text-muted); padding: 30px;">No appointment records found.</div>`;
                return;
            }

            for (let [petName, records] of Object.entries(grouped)) {
                let isExpanded = appointmentsTabShowAll[petName] || false;
                let visibleRecords = isExpanded ? records : records.slice(0, 3);
                let hasMore = records.length > 3;

                let rowsHtml = '';
                visibleRecords.forEach(rec => {
                    let badgeClass = (rec.status || 'PENDING').toLowerCase();
                    rowsHtml += `
                        <tr>
                            <td style="color: var(--text-color); font-weight: 500;">${rec.service}</td>
                            <td style="color: var(--text-muted);"><i class="fa-regular fa-calendar" style="margin-right: 6px;"></i> ${rec.date}</td>
                            <td><span class="badge ${badgeClass}">${rec.status || 'PENDING'}</span></td>
                        </tr>
                    `;
                });

                let seeMoreBtnHtml = hasMore ? `
                    <div style="padding: 10px 20px; background: var(--bg-main); border-top: 1px solid var(--border-color); text-align: center;">
                        <button class="see-more-toggle" onclick="togglePetGroupSeeMore('${petName}')">
                            ${isExpanded ? 'See Less ▲' : `See More (${records.length - 3} more) ▼`}
                        </button>
                    </div>
                ` : '';

                container.innerHTML += `
                    <div class="card" style="padding: 0; overflow: hidden;">
                        <div style="background: var(--bg-main); padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h4 style="font-size: 14px; font-weight: 600; color: var(--heading-color); display: flex; align-items: center; gap: 8px;">
                                    <i class="fa-solid fa-paw" style="color: var(--primary-accent);"></i> ${petName}
                                </h4>
                                <span style="font-size: 11px; color: var(--text-muted);">${records.length} appointment${records.length > 1 ? 's' : ''} recorded</span>
                            </div>
                            <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; background: var(--card-bg); border: 1px solid var(--border-color); padding: 4px 10px; border-radius: 6px; color: var(--text-muted);">Pet Record</span>
                        </div>
                        <table class="table" style="margin: 0;">
                            <thead>
                                <tr>
                                    <th style="padding-left: 20px;">SERVICE</th>
                                    <th>APPOINTMENT DATE</th>
                                    <th style="padding-right: 20px;">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rowsHtml}
                            </tbody>
                        </table>
                        ${seeMoreBtnHtml}
                    </div>
                `;
            }
        }

        function loadSavedPets() {
            let pets = JSON.parse(localStorage.getItem('registered_pets_' + userIdentifier) || '[]');

            document.getElementById('petCountDisplay').innerText = pets.length;

            const container = document.getElementById('registeredPetsContainer');
            const dropdown = document.getElementById('modalPetSelect');

            container.innerHTML = '';
            if (dropdown) dropdown.innerHTML = '<option value="">-- Choose from My Pets --</option>';

            if (pets.length === 0) {
                container.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: var(--text-muted); padding: 40px; font-size: 14px;">No registered pets found. Click "Add Pet" to register your first pet profile.</div>`;
            } else {
                pets.forEach(pet => {
                    let iconClass = pet.species === 'Cat' ? 'fa-cat' : (pet.species === 'Rabbit' ? 'fa-hippo' : 'fa-dog');
                    container.innerHTML += `
                        <div style="background: var(--bg-main); padding: 18px; border-radius: 10px; border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <h4 style="color: var(--heading-color); margin-bottom: 6px; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                                    <i class="fa-solid ${iconClass}" style="color: var(--primary-accent);"></i> ${pet.name}
                                </h4>
                                <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 4px;">Breed: ${pet.breed} (${pet.species})</p>
                                <p style="font-size: 13px; color: var(--text-muted);">Details: ${pet.age}</p>
                            </div>
                            <button onclick="bookForPet('${pet.name}', '${pet.breed} (${pet.species})')" class="action-btn" style="margin-top: 16px; font-size: 12px; padding: 6px 12px; align-self: flex-start;">Make Appointment</button>
                        </div>
                    `;

                    if (dropdown) {
                        dropdown.innerHTML += `<option value="${pet.name} (${pet.breed})">${pet.name} - ${pet.breed} (${pet.species})</option>`;
                    }
                });
            }

            let dbAppointments = [];
            @if (clientAppointments.Any())
            {
                        foreach (var item in clientAppointments)
                        {
                                    @:dbAppointments.push({ id: '@item.Id', petName: '@item.PetName', service: '@item.Service', date: '@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")', rawDate: '@item.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")', status: '@item.Status' });
                        }
            }

            let statusOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides_' + userIdentifier) || '{}');

            let allAppointments = dbAppointments.map(item => {
                if (item.id && statusOverrides[item.id]) {
                    item.status = statusOverrides[item.id].status;
                    if (statusOverrides[item.id].date) {
                        item.date = statusOverrides[item.id].date;
                        item.rawDate = statusOverrides[item.id].rawDate;
                    }
                }
                return item;
            });

            const activeApptsCount = allAppointments.filter(a => (a.status || '').toLowerCase() !== 'cancelled' && (a.status || '').toLowerCase() !== 'rejected').length;
            const activeCountElem = document.getElementById('activeAppointmentsCountDisplay');
            if (activeCountElem) activeCountElem.innerText = activeApptsCount;

            const combinedTableBody = document.getElementById('combinedAppointmentsTableBody');
            const seeMoreContainer = document.getElementById('dashboardSeeMoreContainer');

            if (combinedTableBody) {
                combinedTableBody.innerHTML = '';
                if (allAppointments.length > 0) {
                    let limit = dashboardShowAll ? allAppointments.length : 5;
                    let visibleList = allAppointments.slice(0, limit);

                    visibleList.forEach(item => {
                        let badgeClass = (item.status || 'PENDING').toLowerCase();
                        let actionButtons = (item.status && (item.status.toLowerCase() == 'cancelled' || item.status.toLowerCase() == 'rejected')) ?
                            `<span style="font-size: 11px; color: var(--text-muted);">No actions</span>` :
                            `<button class="btn-outline-warning" onclick="openRescheduleModal('${item.id || ''}', '${item.petName}', '${item.rawDate || ''}')"><i class="fa-solid fa-clock-rotate-left"></i> Reschedule</button>
                             <button class="btn-outline-danger" onclick="openCancelModal('${item.id || ''}', '${item.petName}')"><i class="fa-solid fa-xmark"></i> Cancel</button>`;

                        combinedTableBody.innerHTML += `
                            <tr>
                                <td><strong>${item.petName}</strong></td>
                                <td>${item.service}</td>
                                <td>${item.date}</td>
                                <td><span class="badge ${badgeClass}">${item.status || 'PENDING'}</span></td>
                                <td>${actionButtons}</td>
                            </tr>
                        `;
                    });

                    if (allAppointments.length > 5) {
                        seeMoreContainer.innerHTML = `
                            <button class="see-more-toggle" onclick="toggleDashboardSeeMore()">
                                ${dashboardShowAll ? 'See Less ▲' : `See More (${allAppointments.length - 5} more) ▼`}
                            </button>
                        `;
                    } else {
                        seeMoreContainer.innerHTML = '';
                    }
                } else {
                    combinedTableBody.innerHTML = `
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 24px;">No appointment records found.</td>
                        </tr>
                    `;
                    seeMoreContainer.innerHTML = '';
                }
            }
        }

        function updateModalPetInput(selectElem) {
            if (selectElem.value) {
                document.getElementById('modalPetName').value = selectElem.value;
            }
        }

        function loadClientAnnouncements() {
            let list = JSON.parse(localStorage.getItem('clinic_announcements') || '[]');
            if (list.length === 0) {
                list = [
                    { title: 'Community Anti-Rabies Drive', content: 'Scheduled this Saturday at the Alaminos City Veterinary Office facility.', date: 'Nov 10, 2026' },
                    { title: 'Holiday Operating Hours', content: 'Regular clinic schedules apply throughout the upcoming holiday cycle.', date: 'Nov 01, 2026' }
                ];
                localStorage.setItem('clinic_announcements', JSON.stringify(list));
            }

            const container = document.getElementById('clientAnnouncementsContainer');
            if (container) {
                container.innerHTML = '';
                list.forEach(ann => {
                    container.innerHTML += `
                        <li style="border-bottom: 1px solid var(--table-border); padding-bottom: 8px; margin-bottom: 8px;">
                            <strong style="color: var(--heading-color); display: block; margin-bottom: 2px;">${ann.title}</strong>
                            <p style="margin-bottom: 4px;">${ann.content}</p>
                            <span style="font-size: 11px; color: var(--primary-accent); font-weight: 600;">${ann.date}</span>
                        </li>
                    `;
                });
            }
        }

        function handleLogout() {}

        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.getElementById('themeIcon').className = "fa-solid fa-sun";
            document.getElementById('themeText').innerText = "Light Mode";
        }

        function toggleTheme() {
            const root = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');

            if (root.getAttribute('data-theme') === 'dark') {
                root.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                themeIcon.className = "fa-solid fa-moon";
                themeText.innerText = "Dark Mode";
            } else {
                root.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeIcon.className = "fa-solid fa-sun";
                themeText.innerText = "Light Mode";
            }
        }

        function openRescheduleModal(id, petName, currentDate) {
            document.getElementById('rescheduleAppointmentId').value = id;
            document.getElementById('reschedulePetName').value = petName;
            document.getElementById('rescheduleNewDateTime').value = currentDate;
            document.getElementById('rescheduleModal').style.display = 'flex';
        }

        function closeRescheduleModal() {
            document.getElementById('rescheduleModal').style.display = 'none';
        }

        async function submitReschedule(event) {
            event.preventDefault();
            const id = document.getElementById('rescheduleAppointmentId').value;
            const newDateStr = document.getElementById('rescheduleNewDateTime').value;

            if (id) {
                let dObj = new Date(newDateStr);
                let formattedDateStr = dObj.toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                let statusOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides_' + userIdentifier) || '{}');
                statusOverrides[id] = {
                    status: 'RESCHEDULED',
                    date: formattedDateStr,
                    rawDate: newDateStr
                };
                localStorage.setItem('appointment_status_overrides_' + userIdentifier, JSON.stringify(statusOverrides));

                let globalAdminLogs = JSON.parse(localStorage.getItem('admin_appointment_logs') || '{}');
                globalAdminLogs[id] = { status: 'RESCHEDULED', date: formattedDateStr };
                localStorage.setItem('admin_appointment_logs', JSON.stringify(globalAdminLogs));
            }

            try {
                await fetch('/Home/RescheduleAppointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Id: id, AppointmentDate: newDateStr })
                });
            } catch (err) {
                console.error(err);
            }
            showCustomToast('Appointment rescheduled and synced to admin!');
            closeRescheduleModal();
            setTimeout(() => location.reload(), 1000);
        }

        function openCancelModal(id, petName) {
            document.getElementById('cancelAppointmentId').value = id;
            document.getElementById('cancelModalText').innerText = `Are you sure you want to cancel the appointment for ${petName}?`;
            document.getElementById('cancelModal').style.display = 'flex';
        }

        function closeCancelModal() {
            document.getElementById('cancelModal').style.display = 'none';
        }

        async function confirmCancelAppointment() {
            const id = document.getElementById('cancelAppointmentId').value;

            if (id) {
                let statusOverrides = JSON.parse(localStorage.getItem('appointment_status_overrides_' + userIdentifier) || '{}');
                statusOverrides[id] = {
                    status: 'CANCELLED'
                };
                localStorage.setItem('appointment_status_overrides_' + userIdentifier, JSON.stringify(statusOverrides));

                let globalAdminLogs = JSON.parse(localStorage.getItem('admin_appointment_logs') || '{}');
                globalAdminLogs[id] = { status: 'CANCELLED' };
                localStorage.setItem('admin_appointment_logs', JSON.stringify(globalAdminLogs));
            }

            try {
                await fetch('/Home/CancelAppointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Id: id })
                });
            } catch (err) {
                console.error(err);
            }
            showCustomToast('Appointment cancelled and synced to admin.');
            closeCancelModal();
            setTimeout(() => location.reload(), 1000);
        }

        function openMyPetsModal() {
            document.getElementById('myPetsModal').style.display = 'flex';
        }

        function closeMyPetsModal() {
            document.getElementById('myPetsModal').style.display = 'none';
            document.getElementById('petRegistrationForm').reset();
        }

        function registerNewPet(event) {
            event.preventDefault();
            const name = document.getElementById('regPetName').value.trim();
            const species = document.getElementById('regPetSpecies').value;
            const breed = document.getElementById('regPetBreed').value.trim();
            const age = document.getElementById('regPetAge').value.trim();

            let pets = JSON.parse(localStorage.getItem('registered_pets_' + userIdentifier) || '[]');
            pets.push({ name, species, breed, age });
            localStorage.setItem('registered_pets_' + userIdentifier, JSON.stringify(pets));

            showCustomToast('Pet registered successfully!');
            closeMyPetsModal();
            loadSavedPets();
            loadAppointmentsPageView();
        }

        function bookForPet(petName, petBreedInfo) {
            document.getElementById('modalPetName').value = `${petName} (${petBreedInfo})`;
            openAppointmentModal();
        }

        function openProfileModal() {
            let savedConfig = localStorage.getItem('pet_studio_config_' + userIdentifier);
            if (savedConfig) {
                try {
                    let config = JSON.parse(savedConfig);
                    currentSpecies = config.species || 'dog';
                    currentFurColor = config.furColor || '#0284c7';
                    currentEars = config.ears || 'default';
                    currentExpression = config.expression || 'happy';
                    currentOutfit = config.outfit || 'tee';

                    if (config.name) {
                        document.getElementById('modalDisplayName').value = config.name;
                    }

                    setSpecies(currentSpecies);
                    setEars(currentEars);
                    setExpression(currentExpression);
                    setOutfit(currentOutfit);
                } catch(e) { console.error(e); }
            }
            renderStudioPet();
            document.getElementById('profileModal').style.display = 'flex';
        }
        function closeProfileModal() { document.getElementById('profileModal').style.display = 'none'; }

        function openAppointmentModal() { document.getElementById('appointmentModal').style.display = 'flex'; }
        function closeAppointmentModal() {
            document.getElementById('appointmentModal').style.display = 'none';
            document.getElementById('appointmentForm').reset();
        }

        async function submitAppointment(event) {
            event.preventDefault();
            const petName = document.getElementById('modalPetName').value.trim();
            const service = document.getElementById('modalService').value;
            const appDate = document.getElementById('modalDateTime').value;

            if (!petName || !service || !appDate) {
                showCustomToast('Please fill out all required appointment fields.', 'error');
                return;
            }

            const payload = {
                ClientName: document.getElementById('headerDisplayName').innerText,
                PetName: petName,
                Service: service,
                AppointmentDate: appDate
            };

            try {
                const response = await fetch('/Home/CreateAppointment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    showCustomToast('Appointment successfully booked and saved!');
                    closeAppointmentModal();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showCustomToast('Server error: Hindi nai-save ang appointment.', 'error', 'error');
                }
            } catch (err) {
                console.error('Fetch error:', err);
                showCustomToast('May problema sa koneksyon patungo sa server.', 'error');
            }
        }

        let isChatOpen = false;
        function toggleChatWindow() {
            isChatOpen = !isChatOpen;
            document.getElementById('chatWindow').style.display = isChatOpen ? 'flex' : 'none';
        }

        function handleChatKeyPress(event) {
            if (event.key === 'Enter') sendChatMessage();
        }

        async function sendChatMessage() {
            const inputField = document.getElementById('chatInput');
            const messageText = inputField.value.trim();
            if (!messageText) return;

            const chatMessages = document.getElementById('chatMessages');
            chatMessages.innerHTML += `<div style="background: var(--primary-accent); color: white; padding: 8px 12px; border-radius: 6px; max-width: 85%; align-self: flex-end; font-size: 13px;">${escapeHtml(messageText)}</div>`;
            inputField.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: messageText })
                });
                const data = await response.json();
                chatMessages.innerHTML += `<div style="background: var(--card-bg); border: 1px solid var(--border-color); color: var(--heading-color); padding: 8px 12px; border-radius: 6px; max-width: 85%; align-self: flex-start; font-size: 13px;">${data.reply}</div>`;
                chatMessages.scrollTop = chatMessages.scrollHeight;
            } catch (error) {
                chatMessages.innerHTML += `<div style="background: #fee2e2; color: #dc2626; padding: 8px 12px; border-radius: 6px; font-size: 13px;">Connection error.</div>`;
            }
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>